        "jsCode": "const body = $input.first().json.body || $input.first().json;\n\nconst nome = (body.nome || '').trim();\nconst telefone = (body.telefone || '').replace(/\\D/g, '');\nconst empresa = (body.empresa || '').trim();\nconst servico = body.servico || 'outro';\nconst mensagem = (body.mensagem || '').trim();\nconst origem = body.origem || 'site';\n\nif (!nome || !telefone) {\n  throw new Error('nome e telefone sao obrigatorios');\n}\n\nreturn [{\n  json: {\n    nome,\n    telefone,\n    empresa,\n    segmento: servico,\n    dor_principal: mensagem || ('Interesse em ' + servico),\n    origem,\n    status: 'novo',\n    temperatura: 'morno'\n  }\n}];"
      },
