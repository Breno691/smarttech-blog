---
import Nav from '../components/Nav.astro';
import GTMHead from '../components/GTMHead.astro';
import GTMBody from '../components/GTMBody.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';

const siteURL = Astro.site?.href ?? 'https://smartops-ia.com.br/';
const canonicalURL = new URL('/teste-soro', siteURL).href;
---

<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <GTMHead />

  <title>Teste Soro AI | SmartOps</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="canonical" href={canonicalURL} />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" href="/favicon.ico" />

  <GoogleAnalytics />
</head>
<body>
  <GTMBody />
  <Nav current="/teste-soro" />

  <section class="test-banner">
    <div class="container">
      <p>🧪 Página de teste do Soro AI — <strong>fora de busca</strong> (marcada noindex) até você decidir se fica.</p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h1>Widget de blog — Soro AI</h1>
      <p class="sub">O que aparece abaixo é gerado pelo script do Soro, carregado direto da conta dele.</p>
      <div id="soro-blog"></div>
      <script src="https://app.trysoro.com/api/embed/cbdd1ad1-6015-4fee-8298-64f837c99b3b" defer></script>
    </div>
  </section>

  <footer class="site-footer">
    <div class="container">
      <p>© 2026 SmartOps IA · Breno Luiz</p>
      <nav><a href="/">Home</a> · <a href="/blog">Blog</a></nav>
    </div>
  </footer>
</body>
</html>

<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: 'Inter', system-ui, sans-serif; background: #07070f; color: #e2e8f0; line-height: 1.6; }
  .container { max-width: 1200px; margin: 0 auto; padding: 0 1.5rem; }
  .container.narrow { max-width: 800px; }
  .section { padding: 3rem 0 5rem; }

  .test-banner { background: rgba(251, 191, 36, 0.1); border-bottom: 1px solid rgba(251, 191, 36, 0.25); padding: 0.75rem 0; }
  .test-banner p { font-size: 0.85rem; color: #fbbf24; text-align: center; }
  .test-banner strong { color: #fff; }

  h1 { font-size: clamp(1.6rem, 3.5vw, 2.2rem); font-weight: 800; letter-spacing: -0.02em; margin: 2rem 0 0.5rem; }
  .sub { color: rgba(255,255,255,0.55); font-size: 0.92rem; margin-bottom: 2rem; }

  #soro-blog { min-height: 200px; background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.07); border-radius: 12px; padding: 1.5rem; }

  .site-footer { background: #04040a; border-top: 1px solid rgba(255,255,255,0.05); padding: 2rem 0; text-align: center; margin-top: 4rem; }
  .site-footer p { font-size: 0.8rem; color: rgba(255,255,255,0.3); margin-bottom: 0.5rem; }
  .site-footer nav a { font-size: 0.8rem; color: rgba(255,255,255,0.3); text-decoration: none; }
  .site-footer nav a:hover { color: #fff; }
</style>
