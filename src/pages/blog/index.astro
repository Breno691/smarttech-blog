---
import { getCollection } from 'astro:content';
import Nav from '../../components/Nav.astro';
import GTMHead from '../../components/GTMHead.astro';
import GTMBody from '../../components/GTMBody.astro';
import GoogleAnalytics from '../../components/GoogleAnalytics.astro';
import MetaPixel from '../../components/MetaPixel.astro';
import EventTracking from '../../components/EventTracking.astro';

const allPosts = await getCollection('blog');
const posts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
const siteURL = Astro.site?.href ?? 'https://smartops-ia.com.br/';

const categories = [
  { id: 'todos', label: 'Todos' },
  { id: 'lean-six-sigma', label: 'Lean Six Sigma' },
  { id: 'automacao', label: 'Automação com IA' },
  { id: 'melhoria-continua', label: 'Melhoria Contínua' },
  { id: 'manutencao', label: 'Manutenção & TI' },
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': `${canonicalURL}#webpage`,
      url: canonicalURL,
      name: 'Blog | SmartOps IA — Lean Six Sigma, Automação e Melhoria Contínua',
      description: 'Artigos sobre Lean Six Sigma, automação com IA, melhoria contínua e eficiência operacional para pequenas empresas.',
      inLanguage: 'pt-BR',
      isPartOf: { '@id': `${siteURL}#website` },
      breadcrumb: {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: siteURL },
          { '@type': 'ListItem', position: 2, name: 'Blog', item: canonicalURL },
        ],
      },
    },
  ],
};

function formatDate(date: Date) {
  return date.toLocaleDateString('pt-BR', { year: 'numeric', month: 'short', day: 'numeric' });
}

const categoryLabel: Record<string, string> = {
  'lean-six-sigma': 'Lean Six Sigma',
  'automacao': 'Automação',
  'melhoria-continua': 'Melhoria Contínua',
  'manutencao': 'Manutenção & TI',
  'geral': 'Geral',
};
---

<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://www.googletagmanager.com" />
    <link rel="preconnect" href="https://www.google-analytics.com" />
    <GTMHead />
    <MetaPixel />

    <title>Blog | SmartOps IA — Lean Six Sigma, Automação e Melhoria Contínua</title>
    <meta name="description" content="Artigos práticos sobre Lean Six Sigma, automação com IA e melhoria contínua para pequenas empresas que querem parar de apagar incêndio e começar a escalar." />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content="Blog | SmartOps IA — Lean Six Sigma e Automação" />
    <meta property="og:description" content="Artigos práticos sobre Lean Six Sigma, automação com IA e melhoria contínua para pequenas empresas." />
    <meta property="og:image" content={new URL('/og-default.svg', Astro.site).href} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="SmartOps IA" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
    <GoogleAnalytics />
  </head>

  <body>
    <GTMBody />

    <Nav current="/blog" />

    <main>
      <!-- Hero -->
      <section class="blog-hero">
        <div class="container">
          <div class="hero-badge">
            <span class="dot"></span>
            {posts.length} artigos publicados
          </div>
          <h1>Blog <span class="grad">SmartOps IA</span></h1>
          <p>Lean Six Sigma, automação com IA e melhoria contínua em linguagem de quem tem empresa pra tocar — não de faculdade.</p>
        </div>
      </section>

      <!-- Filtros por categoria -->
      <section class="filters-bar">
        <div class="container">
          <div class="filter-tabs" id="filter-tabs">
            {categories.map(c => (
              <button class={`filter-btn ${c.id === 'todos' ? 'active' : ''}`} data-cat={c.id}>
                {c.label}
              </button>
            ))}
          </div>
          <div class="post-count" id="post-count">{posts.length} artigos</div>
        </div>
      </section>

      <!-- Grid de posts -->
      <section class="posts-section">
        <div class="container">
          <div class="post-grid" id="post-grid">
            {posts.map(post => (
              <article class="post-card" data-category={post.data.category ?? 'geral'}>
                <a href={`/blog/${post.id.replace(/\.mdx?$/, '')}`} class="card-inner">
                  <div class="card-top">
                    <span class="cat-badge">{categoryLabel[post.data.category ?? 'geral'] ?? post.data.category}</span>
                    <time datetime={post.data.pubDate.toISOString()} class="card-date">
                      {formatDate(post.data.pubDate)}
                    </time>
                  </div>
                  <h2 class="card-title">{post.data.title}</h2>
                  <p class="card-desc">{post.data.description?.slice(0, 115)}…</p>
                  <span class="card-link">Ler artigo →</span>
                </a>
              </article>
            ))}
          </div>

          <div class="no-results" id="no-results" style="display:none">
            <p>Nenhum artigo encontrado nessa categoria.</p>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="container">
        <p>© 2026 SmartOps IA · Lean Six Sigma &amp; Automação · Belo Horizonte, MG</p>
        <nav>
          <a href="/">Home</a> · <a href="/lean-six-sigma">Lean Six Sigma</a> · <a href="/automacao">Automação</a> · <a href="/blog">Blog</a> · <a href="/sobre">Sobre</a>
        </nav>
      </div>
    </footer>

    <EventTracking />
  </body>
</html>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const cards = document.querySelectorAll<HTMLElement>('.post-card');
  const countEl = document.getElementById('post-count');
  const noResults = document.getElementById('no-results');

  const params = new URLSearchParams(window.location.search);
  const initialCat = params.get('categoria') || 'todos';

  function setActive(cat: string) {
    tabs.forEach(t => t.classList.toggle('active', t.dataset.cat === cat));
    let visible = 0;
    cards.forEach(c => {
      const show = cat === 'todos' || c.dataset.category === cat;
      c.style.display = show ? '' : 'none';
      if (show) visible++;
    });
    if (countEl) countEl.textContent = `${visible} artigos`;
    if (noResults) noResults.style.display = visible === 0 ? 'block' : 'none';
  }

  setActive(initialCat);

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const cat = tab.dataset.cat || 'todos';
      setActive(cat);
      const url = new URL(window.location.href);
      cat === 'todos' ? url.searchParams.delete('categoria') : url.searchParams.set('categoria', cat);
      window.history.replaceState({}, '', url.toString());
    });
  });
</script>

<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: 'Inter', system-ui, sans-serif; background: #07070f; color: #e2e8f0; line-height: 1.6; }
  .container { max-width: 1200px; margin: 0 auto; padding: 0 1.5rem; }
  .grad { background: linear-gradient(135deg, #a78bfa, #10b981); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }

  /* Hero */
  .blog-hero { padding: 4rem 0 2.5rem; }
  .hero-badge { display: inline-flex; align-items: center; gap: 0.5rem; background: rgba(167,139,250,0.1); border: 1px solid rgba(167,139,250,0.2); color: #a78bfa; font-size: 0.78rem; font-weight: 600; padding: 0.3rem 0.8rem; border-radius: 20px; margin-bottom: 1rem; }
  .dot { width: 6px; height: 6px; border-radius: 50%; background: #10b981; }
  h1 { font-size: clamp(2rem, 5vw, 3rem); font-weight: 900; letter-spacing: -0.03em; margin-bottom: 0.75rem; }
  .blog-hero p { color: rgba(255,255,255,0.6); font-size: 1.05rem; max-width: 580px; }

  /* Filters */
  .filters-bar { padding: 1.5rem 0 2rem; border-bottom: 1px solid rgba(255,255,255,0.06); position: sticky; top: 64px; background: rgba(7,7,15,0.95); backdrop-filter: blur(12px); z-index: 50; }
  .filters-bar .container { display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
  .filter-tabs { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .filter-btn { background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); color: rgba(255,255,255,0.55); font-size: 0.83rem; font-weight: 500; padding: 0.4rem 1rem; border-radius: 20px; cursor: pointer; transition: all 0.2s; }
  .filter-btn:hover { color: #fff; border-color: rgba(255,255,255,0.2); }
  .filter-btn.active { background: rgba(167,139,250,0.15); border-color: rgba(167,139,250,0.4); color: #c4b5fd; font-weight: 700; }
  .post-count { font-size: 0.8rem; color: rgba(255,255,255,0.3); white-space: nowrap; }

  /* Grid */
  .posts-section { padding: 2.5rem 0 5rem; }
  .post-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.25rem; }

  .post-card { background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.07); border-radius: 12px; overflow: hidden; transition: border-color 0.2s, transform 0.2s; }
  .post-card:hover { border-color: rgba(167,139,250,0.35); transform: translateY(-2px); }

  .card-inner { display: flex; flex-direction: column; gap: 0.6rem; padding: 1.4rem; text-decoration: none; color: inherit; height: 100%; }

  .card-top { display: flex; justify-content: space-between; align-items: center; gap: 0.5rem; }
  .cat-badge { font-size: 0.68rem; font-weight: 700; padding: 0.2rem 0.6rem; border-radius: 10px; background: rgba(167,139,250,0.12); color: #a78bfa; letter-spacing: 0.04em; text-transform: uppercase; white-space: nowrap; }
  .card-date { font-size: 0.72rem; color: rgba(255,255,255,0.3); white-space: nowrap; }

  .card-title { font-size: 0.97rem; font-weight: 700; line-height: 1.4; color: #fff; }
  .card-desc { font-size: 0.83rem; color: rgba(255,255,255,0.5); line-height: 1.55; flex: 1; }
  .card-link { font-size: 0.8rem; color: #a78bfa; font-weight: 600; margin-top: auto; }

  .no-results { text-align: center; padding: 4rem 0; color: rgba(255,255,255,0.4); }

  /* Footer */
  .site-footer { background: #04040a; border-top: 1px solid rgba(255,255,255,0.05); padding: 2rem 0; text-align: center; }
  .site-footer p { font-size: 0.8rem; color: rgba(255,255,255,0.3); margin-bottom: 0.5rem; }
  .site-footer nav a { font-size: 0.8rem; color: rgba(255,255,255,0.3); text-decoration: none; }
  .site-footer nav a:hover { color: #fff; }
</style>
