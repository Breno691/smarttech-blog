  <script is:inline>
  (function() {
    var WEBHOOK = 'https://n8n-n8nn.sumjyb.easypanel.host/webhook/captura-leads';
    var form = document.getElementById('ls-form');
    var success = document.getElementById('ls-success');
    if (!form || !success) return;

    form.addEventListener('submit', function(e) {
      e.preventDefault();
      var nome = form.nome.value.trim();
      var telefone = form.telefone.value.trim();
      var servico = form.servico.value;

      ['nome','telefone','servico'].forEach(function(f) { form[f].removeAttribute('aria-invalid'); });

      var valid = true;
      if (!nome) { form.nome.setAttribute('aria-invalid','true'); valid = false; }
      if (!telefone) { form.telefone.setAttribute('aria-invalid','true'); valid = false; }
      if (!servico) { form.servico.setAttribute('aria-invalid','true'); valid = false; }
      if (!valid) { form.querySelector('[aria-invalid]').focus(); return; }

      var btn = form.querySelector('.ls-submit');
      btn.disabled = true;
      form.querySelector('.ls-btn-text').hidden = true;
      form.querySelector('.ls-btn-spin').hidden = false;

      var payload = {
        nome: nome, telefone: telefone, servico: servico, empresa: '',
        mensagem: form.mensagem.value.trim(),
        origem: window.location.href, timestamp: new Date().toISOString()
      };

      function onSuccess() {
        form.hidden = true;
        success.hidden = false;
        success.focus();
        if (window.dataLayer) window.dataLayer.push({ event: 'lead_gerado', event_location: 'lean-form', event_label: payload.servico });
        if (typeof fbq === 'function') fbq('track', 'Lead', { content_name: payload.servico });
      }

      function fallbackWA() {
        var lines = ['Olá! Quero um diagnóstico gratuito.','Nome: '+payload.nome,'WhatsApp: '+payload.telefone,'Interesse: '+payload.servico];
        if (payload.mensagem) lines.push('Problema: '+payload.mensagem);
        window.open('https://wa.me/5531972039180?text='+encodeURIComponent(lines.join('\n')),'_blank');
        onSuccess();
      }

      var timeout = new Promise(function(_,rej){ setTimeout(rej,8000); });
      Promise.race([
        fetch(WEBHOOK,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)})
          .then(function(r){ if(!r.ok) throw new Error(); }),
        timeout
      ]).then(onSuccess).catch(fallbackWA);
    });
  })();
  </script>

