  .diag-banner-btn { flex-shrink: 0; display: inline-flex; align-items: center; background: linear-gradient(135deg, #7c3aed, #10b981); color: #fff; font-weight: 700; padding: 0.75rem 1.5rem; border-radius: 10px; text-decoration: none; font-size: 0.92rem; white-space: nowrap; transition: opacity 0.2s; }
