              <div class="hero-stat-sep" aria-hidden="true"></div>
              <div class="hero-stat"><strong><span data-count-to="24">0</span>h</strong><span>1º atendimento</span></div>
              <div class="hero-stat-sep" aria-hidden="true"></div>
              <div class="hero-stat"><strong>BH</strong><span>Belo Horizonte, MG</span></div>
            </div>
          </div>
        </div>
      </section>

      <!-- ── BANNER DIAGNÓSTICO RÁPIDO ── -->
      <section class="diag-banner">
        <div class="container diag-banner-inner">
          <div>
            <p class="diag-banner-label">Leva menos de 1 minuto</p>
