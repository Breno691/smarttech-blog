    overflow: hidden;
  }
  /* Tracker do DMAIC — faixa discreta no canto superior esquerdo (breadcrumb
     de progresso, não protagonista da cena — o protagonista agora é o
     diagrama SIPOC). HTML/CSS de verdade por cima do canvas: mais nítido que
     texto pintado numa textura 3D em ângulo, nunca bloqueia clique/scroll
     (pointer-events:none), sempre acima do <canvas> (z-index). */
  .twin-dmaic-hud {
    position: absolute;
    left: clamp(1rem, 3vw, 1.75rem);
    top: clamp(1rem, 3vw, 1.5rem);
    z-index: 5;
