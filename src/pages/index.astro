<script is:inline>
  // Mobile menu
  const toggle = document.getElementById('mobile-toggle');
  const links = document.getElementById('nav-links');
  if (toggle && links) {
    toggle.addEventListener('click', () => {
      const open = links.classList.toggle('open');
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
  }

  // FAQ icon toggle
  document.querySelectorAll('.faq-item details').forEach(det => {
    det.addEventListener('toggle', () => {
      const icon = det.querySelector('.faq-icon');
      if (icon) icon.textContent = det.open ? '−' : '+';
    });
  });
</script>

<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --bg: #06060e;
    --bg2: #0d0d1c;
    --bg3: #13132a;
    --fg: #e8e8f0;
    --muted: #8b8baa;
    --accent: #7c3aed;
    --accent-l: #a78bfa;
    --accent-glow: rgba(124, 58, 237, 0.25);
    --accent-border: rgba(167, 139, 250, 0.18);
    --green: #25d366;
    --green-h: #1db954;
    --border: rgba(255, 255, 255, 0.07);
    --max-w: 1180px;
    --font: -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
  }

  html { scroll-behavior: smooth; }

  body {
    font-family: var(--font);
    background: var(--bg);
    color: var(--fg);
    line-height: 1.7;
    overflow-x: hidden;
  }

  .container { max-width: var(--max-w); margin: 0 auto; padding: 0 2rem; }

  .gradient-text {
    background: linear-gradient(135deg, var(--accent-l) 0%, var(--accent) 60%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  /* ── FLOAT WPP ── */
  .wpp-float {
    position: fixed;
    bottom: 28px; right: 28px;
    z-index: 500;
    width: 58px; height: 58px;
    background: var(--green);
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 4px 28px rgba(37,211,102,0.5);
    transition: transform 0.3s, box-shadow 0.3s;
    text-decoration: none;
  }
  .wpp-float:hover { transform: scale(1.1); box-shadow: 0 6px 40px rgba(37,211,102,0.7); }

  /* ── BUTTONS ── */
  .btn-wa {
    display: inline-flex; align-items: center; gap: 0.6rem;
    background: var(--green); color: #fff;
    font-weight: 700; font-size: 1rem;
    padding: 0.85rem 1.75rem; border-radius: 12px;
    text-decoration: none;
    transition: background 0.2s, transform 0.15s, box-shadow 0.2s;
    box-shadow: 0 4px 24px rgba(37,211,102,0.25);
  }
  .btn-wa:hover { background: var(--green-h); transform: translateY(-2px); box-shadow: 0 6px 32px rgba(37,211,102,0.4); }
  .btn-wa-lg { font-size: 1.1rem; padding: 1rem 2.25rem; }

  .btn-outline {
    display: inline-flex; align-items: center; gap: 0.5rem;
    border: 1px solid var(--accent-border); color: var(--accent-l);
    font-weight: 600; font-size: 1rem;
    padding: 0.85rem 1.75rem; border-radius: 12px;
    text-decoration: none;
    background: rgba(124,58,237,0.05);
    transition: border-color 0.2s, background 0.2s, transform 0.15s;
  }
  .btn-outline:hover { border-color: var(--accent-l); background: rgba(124,58,237,0.1); transform: translateY(-2px); }

  /* ── SECTIONS ── */
  .section { padding: 6rem 0; }

  .section-header { text-align: center; margin-bottom: 3.5rem; }

  .section-label {
    display: inline-block;
    font-size: 0.7rem; font-weight: 800;
    text-transform: uppercase; letter-spacing: 0.14em;
    color: var(--accent-l);
    border: 1px solid var(--accent-border);
    background: rgba(124,58,237,0.08);
    padding: 0.3rem 0.9rem; border-radius: 9999px;
    margin-bottom: 1rem;
  }

  .section-title {
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
    font-weight: 800; letter-spacing: -0.03em; line-height: 1.15;
    margin-bottom: 1rem;
  }

  .section-sub {
    font-size: 1.05rem; color: var(--muted);
    max-width: 520px; margin: 0 auto; line-height: 1.7;
  }

  /* ── NAVBAR ── */
  header {
    position: sticky; top: 0; z-index: 200;
    border-bottom: 1px solid var(--border);
    backdrop-filter: blur(16px);
    background: rgba(6,6,14,0.85);
  }

  nav {
    max-width: var(--max-w); margin: 0 auto;
    padding: 1rem 2rem;
    display: flex; align-items: center; gap: 1rem;
  }

  .logo {
    font-size: 1.1rem; font-weight: 800;
    text-decoration: none; color: var(--fg);
    margin-right: auto; letter-spacing: -0.02em; flex-shrink: 0;
  }
  .logo span { color: var(--accent-l); }
  .logo em { font-style: normal; color: var(--muted); font-size: 0.85em; }

  .nav-links { display: flex; align-items: center; gap: 0.15rem; }
  .nav-links a {
    color: var(--muted); text-decoration: none;
    font-size: 0.875rem; font-weight: 500;
    padding: 0.4rem 0.75rem; border-radius: 8px;
    transition: color 0.15s, background 0.15s;
  }
  .nav-links a:hover { color: var(--fg); background: rgba(255,255,255,0.05); }

  .nav-wa {
    display: inline-flex; align-items: center; gap: 0.4rem;
    background: rgba(37,211,102,0.1);
    border: 1px solid rgba(37,211,102,0.3);
    color: var(--green);
    font-size: 0.82rem; font-weight: 700;
    padding: 0.45rem 1rem; border-radius: 9px;
    text-decoration: none; flex-shrink: 0;
    transition: background 0.2s;
  }
  .nav-wa:hover { background: rgba(37,211,102,0.18); }

  .mobile-toggle {
    display: none; flex-direction: column; gap: 5px;
    cursor: pointer; background: none; border: none;
    padding: 0.5rem; border-radius: 8px;
  }
  .mobile-toggle span { display: block; width: 22px; height: 2px; background: var(--fg); border-radius: 2px; }

  /* ── HERO ── */
  .hero { position: relative; padding: 7rem 0 6rem; overflow: hidden; }

  .hero-glow {
    position: absolute; top: -100px; left: 50%; transform: translateX(-50%);
    width: 900px; height: 600px;
    background: radial-gradient(ellipse at center, rgba(124,58,237,0.18) 0%, transparent 65%);
    pointer-events: none;
  }

  .hero-inner { position: relative; text-align: center; }

  .hero-badge {
    display: inline-flex; align-items: center; gap: 0.5rem;
    font-size: 0.72rem; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.1em;
    color: var(--accent-l);
    border: 1px solid var(--accent-border);
    background: rgba(124,58,237,0.08);
    padding: 0.4rem 1rem; border-radius: 9999px;
    margin-bottom: 1.75rem;
  }

  .badge-dot {
    width: 7px; height: 7px;
    background: var(--green); border-radius: 50%;
    box-shadow: 0 0 8px var(--green);
    animation: pulse 2s infinite;
  }

  @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }

  .hero h1 {
    font-size: clamp(2.2rem, 5vw, 4rem);
    font-weight: 800; line-height: 1.1;
    letter-spacing: -0.04em; margin-bottom: 1.5rem;
  }

  .hero-sub {
    font-size: 1.1rem; color: var(--muted);
    max-width: 580px; margin: 0 auto 2.5rem; line-height: 1.7;
  }

  .hero-btns {
    display: flex; flex-wrap: wrap; justify-content: center;
    gap: 1rem; margin-bottom: 3.5rem;
  }

  .hero-stats {
    display: flex; align-items: center; justify-content: center;
    gap: 2rem; flex-wrap: wrap;
    border-top: 1px solid var(--border); padding-top: 2.5rem;
  }

  .hero-stat { text-align: center; }
  .hero-stat strong { display: block; font-size: 1.5rem; font-weight: 800; color: var(--accent-l); }
  .hero-stat span { font-size: 0.78rem; color: var(--muted); }
  .hero-stat-sep { width: 1px; height: 36px; background: var(--border); }

  /* ── SERVICES ── */
  .services-section { background: rgba(13,13,28,0.6); }

  .services-grid {
    list-style: none;
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem;
  }

  .service-card {
    background: var(--bg2); border: 1px solid var(--border);
    border-radius: 16px; padding: 1.75rem;
    transition: border-color 0.25s, transform 0.2s, background 0.25s;
    position: relative; overflow: hidden;
  }
  .service-card::before {
    content: ''; position: absolute; inset: 0;
    background: radial-gradient(ellipse at top left, rgba(124,58,237,0.07) 0%, transparent 60%);
    opacity: 0; transition: opacity 0.3s;
  }
  .service-card:hover { border-color: var(--accent-border); transform: translateY(-3px); }
  .service-card:hover::before { opacity: 1; }

  .service-icon {
    width: 46px; height: 46px;
    display: flex; align-items: center; justify-content: center;
    background: rgba(124,58,237,0.1);
    border: 1px solid var(--accent-border);
    border-radius: 12px; margin-bottom: 1.1rem;
    color: var(--accent-l);
  }

  .service-title { font-size: 1rem; font-weight: 700; margin-bottom: 0.55rem; }
  .service-desc { font-size: 0.855rem; color: var(--muted); line-height: 1.65; }

  /* ── PROBLEMS ── */
  .problems-section { background: var(--bg2); }

  .problems-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(6, 1fr); gap: 1rem;
    margin-bottom: 2.5rem;
  }

  .problem-tile {
    background: var(--bg2); border: 1px solid var(--border);
    border-radius: 14px; padding: 1.4rem 0.75rem;
    text-align: center; cursor: default;
    transition: border-color 0.2s, transform 0.2s, background 0.2s;
    display: flex; flex-direction: column; align-items: center; gap: 0.6rem;
  }
  .problem-tile:hover { border-color: rgba(255,46,46,0.3); transform: translateY(-3px); background: rgba(255,46,46,0.03); }

  .problem-icon { font-size: 1.75rem; display: block; }
  .problem-label { font-size: 0.8rem; font-weight: 600; color: var(--fg); }

  .problems-cta {
    background: rgba(124,58,237,0.06);
    border: 1px solid var(--accent-border);
    border-radius: 16px; padding: 2rem;
    display: flex; align-items: center;
    justify-content: space-between; gap: 2rem; flex-wrap: wrap;
  }

  .problems-cta strong { display: block; font-size: 1rem; margin-bottom: 0.4rem; }
  .problems-cta p { font-size: 0.875rem; color: var(--muted); }

  /* ── DIFERENCIAIS ── */
  .diff-section { background: rgba(13,13,28,0.6); }

  .diff-grid {
    list-style: none;
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem;
  }

  .diff-card {
    background: var(--bg2); border: 1px solid var(--border);
    border-radius: 14px; padding: 1.75rem;
    transition: border-color 0.2s, transform 0.2s;
  }
  .diff-card:hover { border-color: var(--accent-border); transform: translateY(-2px); }

  .diff-num {
    font-size: 0.65rem; font-weight: 800;
    color: var(--accent-l); letter-spacing: 0.1em;
    margin-bottom: 0.75rem; display: block;
  }

  .diff-card h3 { font-size: 1rem; font-weight: 700; margin-bottom: 0.55rem; }
  .diff-card p { font-size: 0.855rem; color: var(--muted); line-height: 1.65; }

  /* ── TESTIMONIALS ── */
  .testimonials-section { background: var(--bg2); }

  .testimonials-grid {
    list-style: none;
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem;
  }

  .testimonial-card {
    background: var(--bg); border: 1px solid var(--border);
    border-radius: 16px; padding: 2rem;
    transition: border-color 0.2s, transform 0.2s;
  }
  .testimonial-card:hover { border-color: var(--accent-border); transform: translateY(-3px); }

  .t-stars { color: #fbbf24; font-size: 1rem; letter-spacing: 2px; margin-bottom: 1rem; }
  .t-text { font-size: 0.9rem; color: var(--muted); font-style: italic; line-height: 1.7; margin-bottom: 1.5rem; }
  .t-author { display: flex; align-items: center; gap: 0.85rem; }

  .t-avatar {
    width: 40px; height: 40px; border-radius: 50%;
    background: rgba(124,58,237,0.15);
    border: 1px solid var(--accent-border);
    display: flex; align-items: center; justify-content: center;
    font-weight: 700; font-size: 1rem; color: var(--accent-l);
    flex-shrink: 0;
  }

  .t-name { display: block; font-size: 0.9rem; font-weight: 700; }
  .t-role { display: block; font-size: 0.78rem; color: var(--muted); }

  /* ── LOCAL ── */
  .local-section { background: rgba(13,13,28,0.6); }

