  @media (max-width: 900px) { .services-grid { grid-template-columns: 1fr; } }

  /* Tilt 3D + spotlight (Pacote Vale do Silício) — JS liga --rx/--ry/--mx/--my
     via card-tilt-spotlight.ts, só em desktop (capability 'full'). Sem JS, as
     variáveis caem no fallback e o card fica parado normalmente. */
  .svc-card, .testimonial-card {
    transform: perspective(800px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transition: transform 0.35s ease;
  }
  .svc-card:hover, .testimonial-card:hover { transition: transform 0.05s linear; }
  .svc-card::after, .testimonial-card::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(circle at var(--mx, 50%) var(--my, 50%), rgba(167,139,250,0.16), transparent 60%);
    opacity: 0;
    transition: opacity 0.25s ease;
    pointer-events: none;
  }
  .svc-card:hover::after, .testimonial-card:hover::after { opacity: 1; }

  /* Scroll reveal (Pacote Vale do Silício) — por padrão o conteúdo fica visível
     (se o JS falhar ou não carregar, nada some). Só escondemos pra animar
     quando scroll-reveal.ts confirma que está rodando (classe abaixo), e
     revelamos de novo via .is-visible (IntersectionObserver, sem lib). */
  .reveal, .stagger-reveal { opacity: 1; transform: none; }
  html.reveal-ready .reveal,
  html.reveal-ready .stagger-reveal {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }
  html.reveal-ready .reveal.is-visible,
  html.reveal-ready .stagger-reveal.is-visible { opacity: 1; transform: translateY(0); }
  /* Next Level UI Fase 3 — no desktop, stagger-reveal.ts anima .stagger-reveal
     via GSAP com estilo inline (opacity/transform/skewY), que tem prioridade
     sobre a regra acima automaticamente — não precisa de .is-visible ali. */

  /* Lead */
