---
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const recentPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
const siteURL = Astro.site?.href ?? 'https://smartops-ia.com.br';

const whatsappNumber = '5531987223507';
const whatsappMsg = encodeURIComponent('Olá! Vim pelo site da SmartOps IA e quero saber mais sobre os serviços.');
const whatsappURL = `https://wa.me/${whatsappNumber}?text=${whatsappMsg}`;

function formatDate(date: Date) {
  return date.toLocaleDateString('pt-BR', { year: 'numeric', month: 'short', day: 'numeric' });
}

const schema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'SmartOps IA',
  description: 'Manutenção de computadores, diagnóstico SMART avançado, upgrade SSD, automação IA e SEO local em Nova Pampulha, Morro Alto e Vespasiano.',
  url: siteURL,
  telephone: `+55-31-98722-3507`,
  areaServed: [
    { '@type': 'City', name: 'Nova Pampulha', containedInPlace: { '@type': 'City', name: 'Belo Horizonte' } },
    { '@type': 'City', name: 'Morro Alto' },
    { '@type': 'City', name: 'Vespasiano' },
  ],
  sameAs: [`https://wa.me/${whatsappNumber}`],
};

const services = [
  {
    icon: `<circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/><path d="M11 8v6M8 11h6"/>`,
    title: 'Diagnóstico SMART Avançado',
    desc: 'Análise completa dos parâmetros SMART de HDs e SSDs com CrystalDiskInfo, smartctl, HD Tune e Victoria. Identificamos bad blocks e risco de falha antes que você perca seus dados.',
  },
  {
    icon: `<polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>`,
    title: 'Upgrade SSD M.2 / SATA',
    desc: 'Instalação e clonagem do sistema operacional para SSD NVMe ou SATA. Boot de 4 minutos vai para 12 segundos. 3.500 MB/s de velocidade. Garantia de funcionamento.',
  },
  {
    icon: `<rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/>`,
    title: 'Formatação Completa',
    desc: 'Formatação e reinstalação do Windows com drivers, programas essenciais e configurações otimizadas. Backup completo e verificado antes de qualquer procedimento.',
  },
  {
    icon: `<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>`,
    title: 'Remoção de Vírus',
    desc: 'Eliminação completa de malware, ransomware, adware e spyware. Verificação em múltiplas camadas. Sistema limpo e protegido garantido.',
  },
  {
    icon: `<line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/>`,
    title: 'Consultoria Lean Six Sigma',
    desc: 'Black Belt em Lean Six Sigma aplicado à melhoria de processos em TI e negócios. Reduza desperdícios, automatize com IA e aumente a eficiência da sua operação.',
  },
  {
    icon: `<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>`,
    title: 'Limpeza & Manutenção',
    desc: 'Limpeza interna com ar comprimido, troca de pasta térmica e verificação de dissipadores. Temperatura reduzida, vida útil ampliada, performance restaurada.',
  },
];

const problems = [
  { icon: '🐌', label: 'PC Lento' },
  { icon: '💙', label: 'Tela Azul (BSOD)' },
  { icon: '🦠', label: 'Vírus / Malware' },
  { icon: '🔥', label: 'Superaquecimento' },
  { icon: '💾', label: 'HD com Barulho' },
  { icon: '🔒', label: 'PC Travando' },
  { icon: '🚫', label: 'Não Liga' },
  { icon: '📉', label: 'FPS Baixo' },
  { icon: '⏰', label: 'Boot Lento' },
  { icon: '⚠️', label: 'Erros SMART' },
  { icon: '📁', label: 'Arquivos Sumindo' },
  { icon: '🔇', label: 'Sem Áudio' },
];

const testimonials = [
  {
    stars: 5,
    text: 'Meu notebook demorava 6 minutos para ligar. Depois do upgrade de SSD, está iniciando em menos de 15 segundos. Parece um computador novo! Diagnóstico foi feito na hora, mostrou tudo certinho.',
    name: 'Ana Carolina M.',
    role: 'Arquiteta · Upgrade SSD',
  },
  {
    stars: 5,
    text: 'O técnico mostrou na tela os erros SMART do meu HD. Nunca tinha visto isso antes. O HD estava praticamente morto e eu não sabia. Conseguiu recuperar todos meus arquivos antes de trocar.',
    name: 'Roberto F.',
    role: 'Contador · Recuperação de HD',
  },
  {
    stars: 5,
    text: 'PC gamer travando nos jogos. Descobriu que era superaquecimento da GPU e HD com bad blocks. Resolveu os dois, agora roda tudo no máximo sem travar. Serviço sério e técnico muito honesto.',
    name: 'Lucas S.',
    role: 'Gamer · Diagnóstico + Setup',
  },
];

const faqs = [
  {
    q: 'O que é análise SMART e por que é importante?',
    a: 'SMART é um sistema interno de monitoramento que todos os HDs e SSDs modernos possuem. Ele registra parâmetros como setores defeituosos, erros de leitura, temperatura e horas de uso. Analisando esses dados, identificamos falhas iminentes antes que você perca seus dados — algo que não é possível apenas "olhando" o computador.',
  },
  {
    q: 'Vale a pena colocar SSD? Qual a diferença real?',
    a: 'Sim, é o melhor upgrade que você pode fazer. Um HD mecânico lê dados a cerca de 80–120 MB/s. Um SSD NVMe atinge 3.500 MB/s — 40 vezes mais rápido. Na prática: boot que demorava 4 minutos passa para 12 segundos. Chrome que demorava 18 segundos abre em menos de 2.',
  },
  {
    q: 'Quanto tempo demora uma formatação?',
    a: 'Uma formatação completa, incluindo backup, instalação do Windows, drivers e programas essenciais, normalmente leva entre 3 a 6 horas dependendo da configuração. Trabalhamos para não deixar você sem o computador por mais de 1 dia útil na maioria dos casos.',
  },
  {
    q: 'Meus arquivos ficam seguros na formatação?',
    a: 'Sempre. Antes de qualquer procedimento, realizamos backup completo e verificado dos seus arquivos. Você recebe confirmação do que foi salvo antes de prosseguirmos. Não formatamos nada sem a sua aprovação explícita.',
  },
  {
    q: 'Vocês fazem atendimento remoto?',
    a: 'Sim, para problemas de software, lentidão, vírus, configurações e otimizações. O atendimento remoto é feito com acesso via ferramentas seguras, com sua autorização em tempo real. Você vê tudo o que está sendo feito na tela.',
  },
  {
    q: 'O diagnóstico é gratuito?',
    a: 'O diagnóstico inicial via WhatsApp é feito gratuitamente — você descreve os sintomas e já recebe uma análise preliminar. O diagnóstico técnico completo com leitura SMART pode ser incluído no valor do serviço quando você opta pelo reparo.',
  },
];

const cities = [
  { name: 'Nova Pampulha', sub: 'Belo Horizonte, MG', desc: 'Manutenção, upgrade de SSD, automação e SEO para negócios da região.' },
  { name: 'Morro Alto', sub: 'Região Metropolitana, MG', desc: 'Diagnóstico avançado, formatação e suporte técnico para pessoas e empresas.' },
  { name: 'Vespasiano', sub: 'Região Metropolitana de BH', desc: 'SEO local, manutenção de computadores e consultoria em IA e processos.' },
];
