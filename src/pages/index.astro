    flex-direction: column;
    align-items: flex-start;
    pointer-events: none;
  }
  .twin-dmaic-letters { display: flex; flex-direction: row; gap: clamp(0.4rem, 1vw, 0.7rem); }
  .twin-dmaic-letters span {
    font-family: var(--font);
    font-size: clamp(0.95rem, 1.4vw, 1.25rem);
    font-weight: 900;
    color: rgba(255,255,255,0.16);
    transform: scale(1) translateY(0);
    transition: color 0.6s ease, text-shadow 0.6s ease, transform 0.6s ease;
  }
  .twin-dmaic-letters span.is-active { transform: scale(1.2) translateY(-0.1rem); }
  .twin-dmaic-caption {
    margin-top: 0.4rem;
    font-size: clamp(0.62rem, 0.9vw, 0.72rem);
    font-weight: 700;
    letter-spacing: 0.03em;
    color: var(--muted);
    text-align: left;
    max-width: 13rem;
    transition: color 0.5s ease;
  }
  /* Project Charter (canto esquerdo) e Log do Sistema (canto direito) —
     painéis HTML reais (não canvas), documento/terminal de verdade digitando
     ao vivo. Mesma lógica de sobreposição do tracker acima. */
  .twin-charter-hud, .twin-baseline-hud, .twin-rootcause-hud, .twin-futurestate-hud, .twin-continuous-hud, .twin-logs-hud {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 5;
    width: clamp(13rem, 20vw, 15.5rem);
    background: rgba(11,18,32,0.82);
    border: 1px solid rgba(148,163,184,0.22);
    border-radius: 10px;
    padding: 0.9rem 1rem;
    pointer-events: none;
    transition: opacity 0.8s ease;
  }
  /* Baseline, Root Cause, Future State e Continuous Monitoring ocupam o
     MESMO canto do Project Charter — digital-twin.ts alterna a opacity entre
     eles quando cada fase começa (crossfade, não um corte seco). Todos
     começam invisíveis: só a fase Define é visível no primeiro frame. */
  .twin-charter-hud, .twin-baseline-hud, .twin-rootcause-hud, .twin-futurestate-hud, .twin-continuous-hud { left: clamp(1rem, 3vw, 1.75rem); }
  .twin-charter-hud { border-left: 3px solid var(--accent-l); opacity: 1; }
  .twin-baseline-hud { border-left: 3px solid #22d3ee; opacity: 0; }
  .twin-rootcause-hud { border-left: 3px solid #ef4444; opacity: 0; }
  .twin-futurestate-hud { border-left: 3px solid #34d399; opacity: 0; }
  .twin-continuous-hud { border-left: 3px solid #22d3ee; opacity: 0; }
  .twin-logs-hud { right: clamp(1rem, 3vw, 1.75rem); border-left: 3px solid #22d3ee; font-family: "Courier New", monospace; }
  .twin-charter-title, .twin-baseline-title, .twin-rootcause-title, .twin-futurestate-title, .twin-continuous-title, .twin-logs-title {
    font-size: 0.68rem; font-weight: 800; letter-spacing: 0.08em;
    color: var(--muted); margin-bottom: 0.6rem; text-transform: uppercase;
  }
  .twin-charter-line, .twin-baseline-line, .twin-rootcause-line, .twin-futurestate-line, .twin-continuous-line { font-size: 0.72rem; line-height: 1.5; color: #e2e8f0; margin-bottom: 0.55rem; }
  .twin-charter-line strong, .twin-baseline-line strong, .twin-rootcause-line strong, .twin-futurestate-line strong, .twin-continuous-line strong { display: block; font-size: 0.62rem; letter-spacing: 0.05em; color: #60a5fa; margin-bottom: 0.15rem; }
  .twin-charter-line span::after, .twin-baseline-line span::after, .twin-rootcause-line span::after, .twin-futurestate-line span::after, .twin-continuous-line span::after { content: '_'; opacity: 0.6; }
  .twin-logs-line { font-size: 0.66rem; line-height: 1.6; color: #67e8f9; margin-bottom: 0.4rem; word-break: break-word; }
  /* Fase 11 (08/set/2026): esses painéis viam de `display:none` abaixo de
     900px — ninguém no celular via o Project Charter/log/etc., só a
     simulação "pelada". Usuário pediu que todo mundo veja a experiência
     completa, então em vez de esconder, os painéis empilham (Charter/
     Baseline/Root Cause/Future State/Continuous no topo, Log embaixo),
     ocupando a largura toda — e `.twin-visual` ganha bem mais altura pra
     abrir espaço pros dois sem espremer o diagrama do meio. */
  @media (max-width: 900px) {
    .twin-visual { min-height: 980px; }
    .twin-charter-hud, .twin-baseline-hud, .twin-rootcause-hud, .twin-futurestate-hud, .twin-continuous-hud {
      left: 1rem;
      right: 1rem;
      top: 4.75rem;
      transform: none;
      width: auto;
    }
    .twin-logs-hud {
      left: 1rem;
      right: 1rem;
      top: auto;
      bottom: 1rem;
      transform: none;
      width: auto;
    }
  }
  /* Placeholder CSS puro — mesma lógica do .system-visual-fallback: visível
     sempre, só some (opacity) depois que o canvas real desenha por cima; em
     modo 'reduced' o script nem baixa, então o placeholder fica pra sempre. */
  .twin-visual-fallback {
    width: min(420px, 86%);
    text-align: center;
    background: rgba(6,6,14,0.72);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 1.75rem;
    box-shadow: 0 30px 80px rgba(59,130,246,0.14);
    transition: opacity 0.5s ease;
  }
  .twin-visual-fallback .sysviz-dots { justify-content: center; margin-bottom: 1rem; }
  .twin-fallback-text { font-size: 0.85rem; color: var(--muted); }
  /* Regra antiga (420px) removida daqui — conflitava com o breakpoint de
     900px acima (que precisa de MAIS altura pros painéis empilhados) e,
     por vir depois na cascata, sempre vencia em telas ≤600px. */

