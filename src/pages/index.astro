  .services-grid {
    list-style: none;
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem;
  }

  .service-card {
    background: var(--bg2); border: 1px solid var(--border);
    border-radius: 16px; padding: 1.75rem;
    transition: border-color 0.25s, transform 0.2s, background 0.25s;
    position: relative; overflow: hidden;
  }
  .service-card::before {
    content: ''; position: absolute; inset: 0;
    background: radial-gradient(ellipse at top left, rgba(124,58,237,0.07) 0%, transparent 60%);
    opacity: 0; transition: opacity 0.3s;
  }
  .service-card:hover { border-color: var(--accent-border); transform: translateY(-3px); }
  .service-card:hover::before { opacity: 1; }

  .service-icon {
    width: 46px; height: 46px;
    display: flex; align-items: center; justify-content: center;
    background: rgba(124,58,237,0.1);
    border: 1px solid var(--accent-border);
    border-radius: 12px; margin-bottom: 1.1rem;
    color: var(--accent-l);
  }

  .service-card { cursor: pointer; }
  .service-card:focus-visible { outline: 2px solid var(--accent-l); outline-offset: 2px; }
  .service-title { font-size: 1rem; font-weight: 700; margin-bottom: 0.55rem; }
  .service-desc { font-size: 0.855rem; color: var(--muted); line-height: 1.65; }
  .service-see-more {
    display: inline-block; margin-top: 0.85rem;
    font-size: 0.78rem; font-weight: 600; color: var(--accent-l);
    opacity: 0; transition: opacity 0.2s;
  }
  .service-card:hover .service-see-more { opacity: 1; }

  /* ── PROBLEMS ── */
  .problems-section { background: var(--bg2); }

  .problems-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(6, 1fr); gap: 1rem;
    margin-bottom: 2.5rem;
  }

  .problem-tile {
    background: var(--bg2); border: 1px solid var(--border);
    border-radius: 14px; padding: 1.4rem 0.75rem;
    text-align: center; cursor: pointer;
    transition: border-color 0.2s, transform 0.2s, background 0.2s;
    display: flex; flex-direction: column; align-items: center; gap: 0.6rem;
  }
  .problem-tile:hover { border-color: rgba(255,46,46,0.3); transform: translateY(-3px); background: rgba(255,46,46,0.03); }
  .problem-tile:focus-visible { outline: 2px solid var(--accent-l); outline-offset: 2px; }

  .problem-icon { font-size: 1.75rem; display: block; }
  .problem-label { font-size: 0.8rem; font-weight: 600; color: var(--fg); }
  .problem-hint { font-size: 0.65rem; color: var(--accent-l); opacity: 0; transition: opacity 0.2s; }
  .problem-tile:hover .problem-hint { opacity: 1; }

  .problems-cta {
    background: rgba(124,58,237,0.06);
    border: 1px solid var(--accent-border);
    border-radius: 16px; padding: 2rem;
    display: flex; align-items: center;
    justify-content: space-between; gap: 2rem; flex-wrap: wrap;
  }

  .problems-cta strong { display: block; font-size: 1rem; margin-bottom: 0.4rem; }
  .problems-cta p { font-size: 0.875rem; color: var(--muted); }

  /* ── DIFERENCIAIS ── */
  .diff-section { background: rgba(13,13,28,0.6); }

  .diff-grid {
    list-style: none;
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem;
  }

  .diff-card {
    background: var(--bg2); border: 1px solid var(--border);
    border-radius: 16px; padding: 2rem;
    position: relative; overflow: hidden;
    transition: border-color 0.3s, transform 0.25s, box-shadow 0.3s;
  }

  /* top glow bar – appears on hover */
  .diff-card::before {
    content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px;
    opacity: 0; transition: opacity 0.35s;
  }
  .diff-card[data-accent="cyan"]::before   { background: linear-gradient(90deg, #00e5ff, #0066ff); }
  .diff-card[data-accent="purple"]::before { background: linear-gradient(90deg, var(--accent-l), var(--accent)); }
  .diff-card[data-accent="green"]::before  { background: linear-gradient(90deg, #00e676, #00b4ff); }
  .diff-card[data-accent="amber"]::before  { background: linear-gradient(90deg, #ffb800, #ff6400); }
  .diff-card[data-accent="blue"]::before   { background: linear-gradient(90deg, #0066ff, #00e5ff); }
  .diff-card[data-accent="red"]::before    { background: linear-gradient(90deg, #ff2e2e, #ff6400); }

  .diff-card:hover { transform: translateY(-4px); box-shadow: 0 16px 48px rgba(0,0,0,0.25); }
  .diff-card:hover::before { opacity: 1; }
  .diff-card[data-accent="cyan"]:hover   { border-color: rgba(0,229,255,0.3); }
  .diff-card[data-accent="purple"]:hover { border-color: var(--accent-border); }
  .diff-card[data-accent="green"]:hover  { border-color: rgba(0,230,118,0.3); }
  .diff-card[data-accent="amber"]:hover  { border-color: rgba(255,184,0,0.3); }
  .diff-card[data-accent="blue"]:hover   { border-color: rgba(0,102,255,0.3); }
  .diff-card[data-accent="red"]:hover    { border-color: rgba(255,46,46,0.3); }

  /* ghost number watermark */
  .diff-ghost {
    position: absolute; bottom: -12px; right: 12px;
    font-size: 7rem; font-weight: 900; line-height: 1;
    color: rgba(255,255,255,0.035);
    pointer-events: none; user-select: none;
  }

  /* tag badge */
  .diff-tag {
    display: inline-block;
    font-family: 'Fira Code', 'Cascadia Code', Consolas, monospace;
    font-size: 0.66rem; font-weight: 700; letter-spacing: 0.1em;
    color: var(--accent-l);
    background: rgba(124,58,237,0.1);
    border: 1px solid var(--accent-border);
    padding: 0.2rem 0.65rem; border-radius: 4px;
    margin-bottom: 1rem;
  }

  .diff-card h3 { font-size: 1.05rem; font-weight: 700; margin-bottom: 0.55rem; }
  .diff-card p { font-size: 0.86rem; color: var(--muted); line-height: 1.65; position: relative; }

  /* ── TESTIMONIALS ── */
  .testimonials-section { background: var(--bg2); }

  .testimonials-grid {
    list-style: none;
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem;
  }

  .testimonial-card {
    background: var(--bg); border: 1px solid var(--border);
    border-radius: 20px; padding: 2rem;
    position: relative; overflow: hidden;
    transition: border-color 0.3s, transform 0.25s, box-shadow 0.3s;
  }

  /* gradient shimmer on hover */
  .testimonial-card::before {
    content: ''; position: absolute; top: 0; left: 0; right: 0; height: 1px;
    background: linear-gradient(90deg, transparent, var(--accent-l), transparent);
    opacity: 0; transition: opacity 0.35s;
  }
  .testimonial-card:hover { border-color: var(--accent-border); transform: translateY(-5px); box-shadow: 0 20px 60px rgba(124,58,237,0.12); }
  .testimonial-card:hover::before { opacity: 1; }

  /* big decorative quote mark */
  .t-deco {
    display: block;
    font-size: 5rem; line-height: 1; height: 3.5rem;
    color: var(--accent-l); opacity: 0.18;
    font-family: Georgia, 'Times New Roman', serif;
    margin-bottom: 0.5rem;
    transition: opacity 0.3s;
  }
  .testimonial-card:hover .t-deco { opacity: 0.3; }

  .t-stars {
    color: #fbbf24; font-size: 0.95rem; letter-spacing: 3px; margin-bottom: 1rem;
    filter: drop-shadow(0 0 5px rgba(251,191,36,0.45));
  }
  .t-text {
    font-size: 0.9rem; color: var(--muted); font-style: italic; line-height: 1.75;
    margin-bottom: 1.5rem; position: relative;
  }
  .t-author {
    display: flex; align-items: center; gap: 0.85rem;
    border-top: 1px solid var(--border); padding-top: 1.25rem;
  }

  .t-avatar {
    width: 44px; height: 44px; border-radius: 50%; flex-shrink: 0;
    background: linear-gradient(135deg, var(--accent), var(--accent-l));
    display: flex; align-items: center; justify-content: center;
    font-weight: 800; font-size: 1.1rem; color: #fff;
    box-shadow: 0 4px 14px rgba(124,58,237,0.45);
  }

  .t-name { display: block; font-size: 0.9rem; font-weight: 700; }
  .t-role { display: block; font-size: 0.78rem; color: var(--muted); }

  /* ── LOCAL ── */
  .local-section { background: rgba(13,13,28,0.6); }

  .cities-grid {
    list-style: none;
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem;
  }

  .city-card {
    background: var(--bg2); border: 1px solid var(--border);
    border-radius: 16px; padding: 2rem;
    transition: border-color 0.2s, transform 0.2s;
  }
  .city-card:hover { border-color: var(--accent-border); transform: translateY(-2px); }

  .city-pin { color: var(--accent-l); margin-bottom: 1rem; }
  .city-name { font-size: 1.2rem; font-weight: 800; margin-bottom: 0.3rem; }
  .city-sub { font-size: 0.72rem; color: var(--accent-l); text-transform: uppercase; letter-spacing: 0.08em; font-weight: 600; margin-bottom: 0.85rem; }
  .city-desc { font-size: 0.875rem; color: var(--muted); line-height: 1.6; }

  /* ── FAQ ── */
  .faq-section { background: var(--bg2); }

  .faq-list {
    max-width: 800px; margin: 0 auto;
    display: flex; flex-direction: column; gap: 0.75rem;
  }

  .faq-item {
    background: var(--bg); border: 1px solid var(--border);
    border-radius: 12px; overflow: hidden;
    transition: border-color 0.2s;
  }
  .faq-item:hover { border-color: var(--accent-border); }

  .faq-q {
    display: flex; justify-content: space-between; align-items: center;
    padding: 1.2rem 1.5rem; cursor: pointer; gap: 1rem;
    list-style: none; font-size: 0.95rem; font-weight: 600;
    user-select: none;
  }
  .faq-q::-webkit-details-marker { display: none; }

  .faq-icon {
    width: 28px; height: 28px; flex-shrink: 0;
    background: rgba(124,58,237,0.1);
    border: 1px solid var(--accent-border);
    border-radius: 6px;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.1rem; color: var(--accent-l);
    transition: background 0.2s;
  }

  details[open] .faq-icon { background: rgba(124,58,237,0.2); }

  .faq-a {
    padding: 0 1.5rem 1.25rem;
    font-size: 0.9rem; color: var(--muted); line-height: 1.75;
  }

  /* ── BLOG ── */
  .posts-grid {
    list-style: none;
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem;
    margin-bottom: 2.5rem;
  }

  .post-card {
    background: var(--bg2); border: 1px solid var(--border);
    border-radius: 16px; overflow: hidden;
    transition: border-color 0.2s, transform 0.2s;
  }
  .post-card:hover { border-color: var(--accent-border); transform: translateY(-3px); }

  .post-link { display: block; text-decoration: none; color: inherit; }
  .post-img { width: 100%; height: 175px; object-fit: cover; display: block; }
  .post-body { padding: 1.4rem; }

  .post-tags { display: flex; flex-wrap: wrap; gap: 0.35rem; margin-bottom: 0.7rem; }
  .post-tag {
    background: rgba(124,58,237,0.1); color: var(--accent-l);
    font-size: 0.62rem; font-weight: 700;
    padding: 0.2rem 0.6rem; border-radius: 9999px;
    text-transform: uppercase; letter-spacing: 0.06em;
  }

  .post-title { font-size: 0.98rem; font-weight: 700; line-height: 1.4; margin-bottom: 0.5rem; }
  .post-desc { font-size: 0.845rem; color: var(--muted); line-height: 1.55; margin-bottom: 0.9rem; }
  .post-date { font-size: 0.76rem; color: var(--muted); }

  .blog-cta { text-align: center; }

  /* ── CTA FINAL ── */
  .cta-section { padding: 8rem 0; }

  .cta-inner {
    position: relative; text-align: center;
    background: var(--bg2);
    border: 1px solid var(--accent-border);
    border-radius: 24px; padding: 5rem 2rem; overflow: hidden;
  }

  .cta-glow {
    position: absolute; top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    width: 600px; height: 400px;
    background: radial-gradient(ellipse at center, rgba(124,58,237,0.18) 0%, transparent 70%);
    pointer-events: none;
  }

  .cta-title {
    position: relative;
    font-size: clamp(1.8rem, 4vw, 3rem);
    font-weight: 800; letter-spacing: -0.04em; line-height: 1.15;
    margin-bottom: 1.25rem;
  }

  .cta-sub {
    position: relative;
    font-size: 1.05rem; color: var(--muted);
    max-width: 480px; margin: 0 auto 2.5rem; line-height: 1.7;
  }

  .cta-inner .btn-wa { position: relative; }

  .cta-hint {
    position: relative;
    font-size: 0.78rem; color: var(--muted); margin-top: 1.1rem;
  }

  /* ── FOOTER ── */
  footer { border-top: 1px solid var(--border); }

  .footer-inner {
    display: flex; gap: 4rem; padding-top: 4rem; padding-bottom: 3rem; flex-wrap: wrap;
  }

  .footer-brand { flex: 1; min-width: 200px; }
  .footer-brand .logo { display: inline-block; margin-bottom: 0.85rem; }
  .footer-brand > p { font-size: 0.875rem; color: var(--muted); line-height: 1.65; margin-bottom: 1.1rem; max-width: 280px; }

  .footer-wa {
    display: inline-flex; align-items: center; gap: 0.45rem;
    color: var(--green); font-size: 0.9rem; font-weight: 700;
    text-decoration: none; transition: color 0.15s;
  }
  .footer-wa:hover { color: var(--green-h); }

  .footer-tagline { font-size: 0.75rem; color: var(--accent-l); margin-top: 0.75rem; font-style: italic; }

  .footer-nav { display: flex; gap: 3rem; flex-wrap: wrap; }

  .footer-col { display: flex; flex-direction: column; gap: 0.6rem; min-width: 130px; }

  .footer-col h4 {
    font-size: 0.72rem; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.1em;
    color: var(--fg); margin-bottom: 0.35rem;
  }

  .footer-col a {
    color: var(--muted); text-decoration: none; font-size: 0.875rem;
    transition: color 0.15s;
  }
  .footer-col a:hover { color: var(--accent-l); }

  .footer-bottom {
    border-top: 1px solid var(--border);
    padding: 1.5rem 2rem;
    max-width: var(--max-w); margin: 0 auto;
    display: flex; justify-content: space-between; align-items: center;
    flex-wrap: wrap; gap: 0.5rem;
    font-size: 0.8rem; color: var(--muted);
  }
  .footer-bottom a { color: var(--accent-l); text-decoration: none; }

  /* ── RESPONSIVE ── */
  @media (max-width: 900px) {
    .services-grid { grid-template-columns: repeat(2, 1fr); }
    .diff-grid { grid-template-columns: repeat(2, 1fr); }
    .testimonials-grid { grid-template-columns: 1fr; }
    .cities-grid { grid-template-columns: repeat(2, 1fr); }
    .posts-grid { grid-template-columns: repeat(2, 1fr); }
    .problems-grid { grid-template-columns: repeat(4, 1fr); }
  }

  @media (max-width: 768px) {
    .nav-links {
      display: none; position: absolute; top: 100%; left: 0; right: 0;
      background: rgba(6,6,14,0.98); border-bottom: 1px solid var(--border);
      flex-direction: column; align-items: flex-start;
      padding: 1rem; gap: 0.25rem;
    }
    .nav-links.open { display: flex; }
    .nav-links a { width: 100%; padding: 0.65rem 1rem; }
    .mobile-toggle { display: flex; }
    header { position: relative; }
    .hero { padding: 5rem 0 4rem; }
    .hero-stat-sep { display: none; }
    .footer-inner { flex-direction: column; gap: 2rem; }
    .footer-nav { gap: 2rem; }
  }

  @media (max-width: 600px) {
    .services-grid { grid-template-columns: 1fr; }
    .diff-grid { grid-template-columns: 1fr; }
    .cities-grid { grid-template-columns: 1fr; }
    .posts-grid { grid-template-columns: 1fr; }
    .problems-grid { grid-template-columns: repeat(3, 1fr); }
    .section { padding: 4rem 0; }
    .container { padding: 0 1.25rem; }
    nav { padding: 0.875rem 1.25rem; }
    .cta-section { padding: 4rem 0; }
    .cta-inner { padding: 3rem 1.5rem; }
    .wpp-float { bottom: 16px; right: 16px; width: 50px; height: 50px; }
  }

  /* ── MODAL ── */
  .modal-tpl { display: none; }

  .modal-backdrop {
    position: fixed; inset: 0; z-index: 900;
    background: rgba(6,6,14,0.88);
    backdrop-filter: blur(10px);
    display: flex; align-items: center; justify-content: center;
    padding: 1.5rem;
    opacity: 0; pointer-events: none;
    transition: opacity 0.25s;
  }
  .modal-backdrop.open { opacity: 1; pointer-events: auto; }

  .modal-box {
    background: var(--bg2); border: 1px solid var(--accent-border);
    border-radius: 20px; width: 100%; max-width: 700px; max-height: 88vh;
    display: flex; flex-direction: column;
    transform: translateY(24px); transition: transform 0.28s cubic-bezier(.22,.68,0,1.2);
    position: relative; overflow: hidden;
    box-shadow: 0 32px 80px rgba(0,0,0,0.6);
  }
  .modal-backdrop.open .modal-box { transform: translateY(0); }

  .modal-close {
    position: absolute; top: 1rem; right: 1rem; z-index: 10;
    width: 34px; height: 34px;
    background: rgba(255,255,255,0.06); border: 1px solid var(--border);
    border-radius: 8px; color: var(--muted);
    display: flex; align-items: center; justify-content: center;
    cursor: pointer; transition: background 0.2s, color 0.2s;
  }
  .modal-close:hover { background: rgba(255,255,255,0.12); color: var(--fg); }

  .modal-scroll { overflow-y: auto; flex: 1; }

  .modal-body { padding: 2rem 2rem 0; }

  .modal-svg {
    width: 100%; height: auto; border-radius: 10px;
    margin-bottom: 1.5rem; display: block;
    border: 1px solid var(--border);
  }

  .modal-title { font-size: 1.3rem; font-weight: 800; margin-bottom: 0.45rem; letter-spacing: -0.02em; }
  .modal-lead { font-size: 0.9rem; color: var(--muted); line-height: 1.65; margin-bottom: 1.5rem; }

  .modal-steps { list-style: none; display: flex; flex-direction: column; gap: 0.8rem; padding-bottom: 0.5rem; }
  .modal-step { display: flex; gap: 0.75rem; align-items: flex-start; }
  .modal-step-num {
    flex-shrink: 0; width: 26px; height: 26px; border-radius: 7px;
    background: rgba(124,58,237,0.15); border: 1px solid var(--accent-border);
    color: var(--accent-l); font-size: 0.68rem; font-weight: 800; font-family: monospace;
    display: flex; align-items: center; justify-content: center; margin-top: 1px;
  }
  .modal-step-text { font-size: 0.875rem; color: var(--muted); line-height: 1.65; }
  .modal-step-text strong { color: var(--fg); }

  .modal-wpp {
    padding: 1.5rem 2rem 2rem;
    border-top: 1px solid var(--border);
    margin-top: 1.5rem;
    background: rgba(0,0,0,0.18);
    display: flex; align-items: center; gap: 1rem; flex-wrap: wrap;
  }
  .modal-wpp .btn-wa { flex-shrink: 0; }

  /* ── PROBLEM MODALS ── */
  .prob-modal { padding-bottom: 0.25rem; }

  .prob-header {
    display: flex; align-items: flex-start; gap: 1.1rem;
    margin-bottom: 1.5rem;
  }
  .prob-icon-lg { font-size: 2.75rem; line-height: 1; flex-shrink: 0; }

  .prob-urgency {
    display: inline-block; margin-top: 0.35rem;
    font-size: 0.72rem; font-weight: 700;
    padding: 0.2rem 0.75rem; border-radius: 9999px;
    text-transform: uppercase; letter-spacing: 0.06em;
  }
  .urgency-low { background: rgba(37,211,102,0.1); color: #25d366; border: 1px solid rgba(37,211,102,0.25); }
  .urgency-medium { background: rgba(251,191,36,0.1); color: #fbbf24; border: 1px solid rgba(251,191,36,0.25); }
  .urgency-high { background: rgba(249,115,22,0.1); color: #fb923c; border: 1px solid rgba(249,115,22,0.25); }
  .urgency-critical { background: rgba(239,68,68,0.1); color: #f87171; border: 1px solid rgba(239,68,68,0.3); }

  .prob-causes, .prob-solution { margin-bottom: 1.25rem; }
  .prob-causes h4, .prob-solution h4 {
    font-size: 0.7rem; font-weight: 800; text-transform: uppercase;
    letter-spacing: 0.1em; color: var(--accent-l); margin-bottom: 0.7rem;
  }

  .cause-list, .solution-list { list-style: none; display: flex; flex-direction: column; gap: 0.45rem; }
  .cause-item, .solution-item {
    display: flex; gap: 0.6rem; align-items: flex-start;
    font-size: 0.875rem; color: var(--muted); line-height: 1.5;
  }
  .cause-dot { color: #fb923c; flex-shrink: 0; margin-top: 1px; font-size: 0.75rem; }
  .solution-dot { color: #25d366; flex-shrink: 0; margin-top: 1px; font-size: 0.75rem; }

  @media (max-width: 600px) {
    .modal-backdrop { padding: 0.5rem; align-items: flex-end; }
    .modal-box { border-radius: 20px 20px 0 0; max-height: 92vh; }
    .modal-body { padding: 1.5rem 1.25rem 0; }
    .modal-wpp { padding: 1.25rem; }
    .modal-title { font-size: 1.15rem; }
    .prob-icon-lg { font-size: 2.25rem; }
  }

  /* ── LEAD SECTION ── */
  .lead-section { background: var(--bg2); }

  .lead-grid {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 3.5rem;
    align-items: start;
  }

  .lead-intro { color: var(--muted); font-size: 1.025rem; line-height: 1.7; margin-bottom: 1.75rem; }

  .lead-form { display: flex; flex-direction: column; gap: 1rem; }

  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }

