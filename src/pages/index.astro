                </details>
              </div>
            ))}
          </dl>
        </div>
      </section>

      <!-- ── BLOG PREVIEW ── -->
      {recentPosts.length > 0 && (
        <section class="section blog-section">
          <div class="container">
            <div class="section-header">
              <p class="section-label">Conteúdo</p>
              <h2 class="section-title">Blog <span class="gradient-text">SmartOps</span></h2>
              <p class="section-sub">Artigos sobre IA, SEO e manutenção de computadores.</p>
            </div>
            <ul class="posts-grid">
              {recentPosts.map(post => (
                <li class="post-card">
                  <a href={`/blog/${post.id.replace(/\.mdx?$/, '')}`} class="post-link">
                    {post.data.heroImage && (
                      <img
                        src={post.data.heroImage}
                        alt={post.data.title}
                        width="800"
                        height="420"
                        loading="lazy"
                        decoding="async"
                        class="post-img"
                      />
                    )}
                    <div class="post-body">
                      {post.data.tags.length > 0 && (
                        <div class="post-tags">
                          {post.data.tags.slice(0, 2).map(tag => (
                            <span class="post-tag">{tag}</span>
                          ))}
