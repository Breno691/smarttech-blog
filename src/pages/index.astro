  .gradient-text {
    background: linear-gradient(135deg, var(--accent-l) 0%, var(--accent) 60%);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
  }

  /* Float WPP */
  .wpp-float {
    position: fixed; bottom: 28px; right: 28px; z-index: 500;
    width: 58px; height: 58px; background: var(--green); border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 4px 28px rgba(37,211,102,0.5); transition: transform 0.3s, box-shadow 0.3s; text-decoration: none;
  }
  .wpp-float:hover { transform: scale(1.1); box-shadow: 0 6px 40px rgba(37,211,102,0.7); }

  /* Buttons */
  .btn-wa {
    display: inline-flex; align-items: center; gap: 0.6rem;
    background: var(--green); color: #fff; font-weight: 700; font-size: 1rem;
    padding: 0.85rem 1.75rem; border-radius: 12px; text-decoration: none;
    transition: background 0.2s, transform 0.15s, box-shadow 0.2s;
    box-shadow: 0 4px 24px rgba(37,211,102,0.25);
  }
  .btn-wa:hover { background: var(--green-h); transform: translateY(-2px); box-shadow: 0 6px 32px rgba(37,211,102,0.4); }
  .btn-wa-lg { font-size: 1.1rem; padding: 1rem 2.25rem; }

  .btn-outline {
    display: inline-flex; align-items: center; gap: 0.5rem;
    border: 1px solid var(--accent-border); color: var(--accent-l);
    font-weight: 600; font-size: 1rem; padding: 0.85rem 1.75rem; border-radius: 12px;
    text-decoration: none; background: rgba(124,58,237,0.05);
    transition: border-color 0.2s, background 0.2s, transform 0.15s;
  }
  .btn-outline:hover { border-color: var(--accent-l); background: rgba(124,58,237,0.1); transform: translateY(-2px); }

  /* Sections */
  .section { padding: 6rem 0; }
  .section-header { text-align: center; margin-bottom: 3.5rem; }
  .section-label {
    display: inline-block; font-size: 0.7rem; font-weight: 800;
    text-transform: uppercase; letter-spacing: 0.14em; color: var(--accent-l);
    border: 1px solid var(--accent-border); background: rgba(124,58,237,0.08);
    padding: 0.3rem 0.9rem; border-radius: 9999px; margin-bottom: 1rem;
  }
  .section-title { font-size: clamp(1.75rem, 3.5vw, 2.75rem); font-weight: 800; letter-spacing: -0.03em; line-height: 1.15; margin-bottom: 1rem; }
  .section-sub { font-size: 1.05rem; color: var(--muted); max-width: 520px; margin: 0 auto; line-height: 1.7; }

  /* Nav */
  header { position: sticky; top: 0; z-index: 200; border-bottom: 1px solid var(--border); backdrop-filter: blur(16px); background: rgba(6,6,14,0.85); }
  nav { max-width: var(--max-w); margin: 0 auto; padding: 1rem 2rem; display: flex; align-items: center; gap: 1rem; }
  .logo { font-size: 1.1rem; font-weight: 800; text-decoration: none; color: var(--fg); margin-right: auto; letter-spacing: -0.02em; flex-shrink: 0; }
  .logo span { color: var(--accent-l); }
  .logo em { font-style: normal; color: var(--muted); font-size: 0.85em; }
  .nav-links { display: flex; align-items: center; gap: 0.15rem; }
  .nav-links a { color: var(--muted); text-decoration: none; font-size: 0.875rem; font-weight: 500; padding: 0.4rem 0.75rem; border-radius: 8px; transition: color 0.15s, background 0.15s; }
  .nav-links a:hover { color: var(--fg); background: rgba(255,255,255,0.05); }
  .nav-wa { display: inline-flex; align-items: center; gap: 0.4rem; background: rgba(37,211,102,0.1); border: 1px solid rgba(37,211,102,0.3); color: var(--green); font-size: 0.82rem; font-weight: 700; padding: 0.45rem 1rem; border-radius: 9px; text-decoration: none; flex-shrink: 0; transition: background 0.2s; }
  .nav-wa:hover { background: rgba(37,211,102,0.18); }
  .mobile-toggle { display: none; flex-direction: column; gap: 5px; cursor: pointer; background: none; border: none; padding: 0.5rem; border-radius: 8px; }
  .mobile-toggle span { display: block; width: 22px; height: 2px; background: var(--fg); border-radius: 2px; }

  /* Hero */
  .hero { position: relative; padding: 6rem 0 5rem; overflow: hidden; }
  .hero-glow { position: absolute; top: -100px; left: 50%; transform: translateX(-50%); width: 900px; height: 600px; background: radial-gradient(ellipse at center, rgba(124,58,237,0.18) 0%, transparent 65%); pointer-events: none; }
  .hero-inner { position: relative; display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: center; }
  .hero-text { text-align: left; }
  .hero-visual { display: flex; justify-content: center; align-items: center; }
  .hero-visual img { width: 100%; max-width: 560px; height: auto; filter: drop-shadow(0 20px 60px rgba(124,58,237,0.2)); }
  @media (max-width: 900px) { .hero-inner { grid-template-columns: 1fr; } .hero-text { text-align: center; } .hero-visual { display: none; } }
  .hero-badge { display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--accent-l); border: 1px solid var(--accent-border); background: rgba(124,58,237,0.08); padding: 0.4rem 1rem; border-radius: 9999px; margin-bottom: 1.75rem; }
  .badge-dot { width: 7px; height: 7px; background: var(--green); border-radius: 50%; box-shadow: 0 0 8px var(--green); animation: pulse 2s infinite; }
  @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }
  .hero h1 { font-size: clamp(2.2rem, 5vw, 4rem); font-weight: 800; line-height: 1.1; letter-spacing: -0.04em; margin-bottom: 1.5rem; }
  .hero-sub { font-size: 1.1rem; color: var(--muted); max-width: 580px; margin: 0 auto 2.5rem; line-height: 1.7; }
  .hero-btns { display: flex; flex-wrap: wrap; justify-content: center; gap: 1rem; margin-bottom: 3.5rem; }
  .hero-stats { display: flex; align-items: center; justify-content: center; gap: 2rem; flex-wrap: wrap; border-top: 1px solid var(--border); padding-top: 2.5rem; }
  .hero-stat { text-align: center; }
  .hero-stat strong { display: block; font-size: 1.5rem; font-weight: 800; color: var(--accent-l); }
  .hero-stat span { font-size: 0.78rem; color: var(--muted); }
  .hero-stat-sep { width: 1px; height: 36px; background: var(--border); }

  /* ── SERVICES SECTION ── */
  .services-section { background: rgba(13,13,28,0.6); }

  .svc-layout {
    display: grid;
    grid-template-columns: 1fr 360px;
    gap: 1.25rem;
    align-items: start;
  }

  .svc-card {
    background: var(--bg2);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 2rem;
  }

  .svc-featured {
    border-color: rgba(124,58,237,0.2);
    background: linear-gradient(135deg, rgba(124,58,237,0.05) 0%, rgba(16,185,129,0.03) 100%);
  }

  .svc-side {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
    cursor: pointer;
  }
  .svc-side:hover { border-color: rgba(245,158,11,0.35); transform: translateY(-3px); box-shadow: 0 12px 40px rgba(245,158,11,0.08); }

  .svc-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 0.75rem; margin-bottom: 1.25rem; flex-wrap: wrap; }

  .svc-pills { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; }

  .svc-plus { color: rgba(255,255,255,0.35); font-weight: 700; font-size: 0.9rem; }

  .svc-pill { font-size: 0.66rem; font-weight: 800; letter-spacing: 0.07em; text-transform: uppercase; padding: 0.25rem 0.7rem; border-radius: 9999px; }
  .svc-pill-lean { background: rgba(124,58,237,0.15); border: 1px solid rgba(167,139,250,0.3); color: #c4b5fd; }
  .svc-pill-auto { background: rgba(16,185,129,0.12); border: 1px solid rgba(16,185,129,0.3); color: #6ee7b7; }
  .svc-pill-ti { background: rgba(245,158,11,0.12); border: 1px solid rgba(245,158,11,0.3); color: #fcd34d; }

  .svc-tag-note { font-size: 0.7rem; color: rgba(255,255,255,0.3); white-space: nowrap; line-height: 1.3; text-align: right; }

  .svc-title { font-size: 1.35rem; font-weight: 800; letter-spacing: -0.02em; line-height: 1.3; margin-bottom: 0.65rem; color: #fff; }
  .svc-side .svc-title { font-size: 1.1rem; }

  .svc-sub { font-size: 0.9rem; color: rgba(255,255,255,0.55); line-height: 1.65; margin-bottom: 1.75rem; }

  .svc-problems {
    background: rgba(0,0,0,0.25);
    border: 1px solid rgba(255,255,255,0.05);
    border-radius: 10px;
    padding: 1.25rem;
    margin-bottom: 1.75rem;
  }

  .svc-problems-label {
    font-size: 0.72rem; font-weight: 700; color: rgba(255,255,255,0.4);
    text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 0.85rem;
  }

  .svc-problems-list { list-style: none; display: flex; flex-direction: column; gap: 0.6rem; }

  .svc-problems-list li { display: flex; align-items: flex-start; gap: 0.65rem; font-size: 0.875rem; color: rgba(255,255,255,0.68); line-height: 1.45; }

  .prob-x { color: #f87171; font-weight: 700; flex-shrink: 0; line-height: 1.45; }

  .svc-actions { display: flex; gap: 0.75rem; flex-wrap: wrap; }

  .svc-btn { display: inline-flex; align-items: center; gap: 0.45rem; font-size: 0.85rem; font-weight: 700; padding: 0.55rem 1.25rem; border-radius: 9px; text-decoration: none; transition: opacity 0.2s, transform 0.15s; }
  .svc-btn:hover { opacity: 0.82; transform: translateY(-1px); }
  .svc-btn-lean { background: rgba(124,58,237,0.18); border: 1px solid rgba(167,139,250,0.3); color: #c4b5fd; }
  .svc-btn-auto { background: rgba(16,185,129,0.13); border: 1px solid rgba(16,185,129,0.25); color: #6ee7b7; }

  .svc-ti-list { list-style: none; display: flex; flex-direction: column; gap: 0.7rem; flex: 1; }
  .svc-ti-list li { display: flex; align-items: flex-start; gap: 0.55rem; font-size: 0.875rem; color: rgba(255,255,255,0.62); line-height: 1.45; }
  .svc-ti-list svg { flex-shrink: 0; margin-top: 2px; stroke: #fbbf24; }
  .svc-ti-list strong { color: rgba(255,255,255,0.85); }

  .svc-side-cta {
    display: block; font-size: 0.85rem; font-weight: 700; color: #fbbf24;
    margin-top: auto; padding-top: 1rem; border-top: 1px solid rgba(255,255,255,0.06);
  }

  @media (max-width: 900px) { .svc-layout { grid-template-columns: 1fr; } }

  /* Lead */
  .lead-section { background: var(--bg2); padding: 6rem 0; }
  .lead-header { text-align: center; margin-bottom: 3.5rem; }
  .lead-header h2 { font-size: clamp(1.75rem, 3.5vw, 2.75rem); font-weight: 800; letter-spacing: -0.03em; line-height: 1.15; margin-bottom: 1rem; }
  .lead-tags { display: flex; align-items: center; justify-content: center; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 1rem; }
  .lead-tag { font-size: 0.7rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; padding: 0.25rem 0.75rem; border-radius: 9999px; }
  .lead-tag-lean { background: rgba(124,58,237,0.15); border: 1px solid rgba(167,139,250,0.3); color: #c4b5fd; }
  .lead-tag-auto { background: rgba(16,185,129,0.12); border: 1px solid rgba(16,185,129,0.3); color: #6ee7b7; }
  .lead-tag-ti { background: rgba(245,158,11,0.12); border: 1px solid rgba(245,158,11,0.3); color: #fcd34d; }
  .lead-tag-sep { color: rgba(255,255,255,0.25); font-size: 0.8rem; }
  .lead-subtitle { font-size: 1rem; color: var(--muted); max-width: 540px; margin: 0 auto; line-height: 1.7; }
  .lead-grid { display: grid; grid-template-columns: 1fr 340px; gap: 2.5rem; align-items: start; }
  .lead-form { display: flex; flex-direction: column; gap: 1rem; background: var(--bg); border: 1px solid var(--border); border-radius: 18px; padding: 2rem; }
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .form-group { display: flex; flex-direction: column; gap: 0.4rem; }
  .form-group label { font-size: 0.82rem; font-weight: 600; color: var(--muted); }
  .req { color: #f87171; }
  .form-full { grid-column: 1 / -1; }
  .form-group input, .form-group select, .form-group textarea {
    background: var(--bg2); border: 1px solid var(--border); border-radius: 10px;
    color: var(--fg); font-size: 0.9rem; padding: 0.7rem 1rem;
    font-family: var(--font); transition: border-color 0.2s; outline: none; width: 100%;
  }
  .form-group input:focus, .form-group select:focus, .form-group textarea:focus { border-color: var(--accent-border); }
  .form-group input[aria-invalid="true"], .form-group select[aria-invalid="true"] { border-color: #f87171; }
  .form-group select option { background: var(--bg2); }
  .form-group textarea { resize: vertical; min-height: 110px; }
  .btn-lead {
    background: linear-gradient(135deg, var(--accent), #5b21b6);
    color: #fff; font-size: 1rem; font-weight: 700; padding: 0.9rem 1.5rem;
    border: none; border-radius: 12px; cursor: pointer;
    display: flex; align-items: center; justify-content: center; gap: 0.5rem;
    transition: opacity 0.2s, transform 0.15s; box-shadow: 0 4px 20px rgba(124,58,237,0.35);
  }
  .btn-lead:hover:not(:disabled) { opacity: 0.9; transform: translateY(-1px); }
  .btn-lead:disabled { opacity: 0.65; cursor: not-allowed; }
  .btn-lead-spin { display: none; }
  .btn-lead.is-loading .btn-lead-text { display: none; }
  .btn-lead.is-loading .btn-lead-spin { display: block; }
  .form-privacy { display: flex; align-items: center; gap: 0.4rem; font-size: 0.75rem; color: var(--muted); }
  .lead-success, .lead-error { padding: 2rem; text-align: center; border-radius: 16px; }
  .lead-success { background: rgba(16,185,129,0.06); border: 1px solid rgba(16,185,129,0.2); }
  .lead-error { background: rgba(248,113,113,0.06); border: 1px solid rgba(248,113,113,0.2); }
  .success-check { color: #10b981; margin-bottom: 1rem; display: flex; justify-content: center; }
  .error-icon { color: #f87171; margin-bottom: 1rem; display: flex; justify-content: center; }
  .lead-success h3, .lead-error h3 { font-size: 1.1rem; font-weight: 700; margin-bottom: 0.5rem; }
  .lead-success p, .lead-error p { font-size: 0.875rem; color: var(--muted); margin-bottom: 1.25rem; }
  .error-actions { display: flex; gap: 0.75rem; justify-content: center; flex-wrap: wrap; }
  .btn-retry { background: rgba(248,113,113,0.12); border: 1px solid rgba(248,113,113,0.3); color: #f87171; font-size: 0.875rem; font-weight: 600; padding: 0.6rem 1.25rem; border-radius: 10px; cursor: pointer; }
  .lead-col-info { display: flex; flex-direction: column; gap: 1.25rem; }
  .lead-trust-card { background: var(--bg); border: 1px solid var(--border); border-radius: 16px; padding: 1.75rem; }
  .trust-title { font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--accent-l); margin-bottom: 1.25rem; }
  .trust-steps { list-style: none; display: flex; flex-direction: column; gap: 1.25rem; }
  .trust-steps li { display: flex; gap: 1rem; align-items: flex-start; font-size: 0.875rem; }
  .step-num { font-size: 1.4rem; font-weight: 900; color: rgba(167,139,250,0.25); flex-shrink: 0; line-height: 1; width: 28px; }
  .trust-steps strong { display: block; font-size: 0.875rem; font-weight: 700; margin-bottom: 0.2rem; }
  .trust-steps p { font-size: 0.8rem; color: var(--muted); line-height: 1.6; }
  .lead-guarantee { display: flex; align-items: center; gap: 1rem; background: var(--bg); border: 1px solid var(--border); border-radius: 12px; padding: 1.1rem 1.25rem; }
  .guarantee-icon { font-size: 1.75rem; flex-shrink: 0; }
  .lead-guarantee strong { display: block; font-size: 0.875rem; font-weight: 700; margin-bottom: 0.2rem; }
  .lead-guarantee p { font-size: 0.78rem; color: var(--muted); }
  .lead-wa-direct { display: flex; flex-direction: column; gap: 0.5rem; }
  .wa-direct-label { font-size: 0.8rem; font-weight: 600; color: var(--muted); }
  .wa-direct-hint { font-size: 0.75rem; color: var(--muted); }

  /* Testimonials */
  .testimonials-section { background: var(--bg2); }
  .testimonials-grid { list-style: none; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
  .testimonial-card { background: var(--bg); border: 1px solid var(--border); border-radius: 20px; padding: 2rem; position: relative; overflow: hidden; transition: border-color 0.3s, transform 0.25s, box-shadow 0.3s; }
  .testimonial-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 1px; background: linear-gradient(90deg, transparent, var(--accent-l), transparent); opacity: 0; transition: opacity 0.35s; }
  .testimonial-card:hover { border-color: var(--accent-border); transform: translateY(-5px); box-shadow: 0 20px 60px rgba(124,58,237,0.12); }
  .testimonial-card:hover::before { opacity: 1; }
  .t-deco { display: block; font-size: 5rem; line-height: 1; height: 3.5rem; color: var(--accent-l); opacity: 0.18; font-family: Georgia, serif; margin-bottom: 0.5rem; }
  .t-stars { color: #fbbf24; font-size: 0.95rem; letter-spacing: 3px; margin-bottom: 1rem; }
  .t-text { font-size: 0.9rem; color: var(--muted); font-style: italic; line-height: 1.75; margin-bottom: 1.5rem; }
  .t-author { display: flex; align-items: center; gap: 0.85rem; border-top: 1px solid var(--border); padding-top: 1.25rem; }
  .t-avatar { width: 44px; height: 44px; border-radius: 50%; flex-shrink: 0; background: linear-gradient(135deg, var(--accent), var(--accent-l)); display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 1.1rem; color: #fff; }
  .t-name { display: block; font-size: 0.9rem; font-weight: 700; }
  .t-role { display: block; font-size: 0.78rem; color: var(--muted); }

  /* Cities */
  .local-section { background: rgba(13,13,28,0.6); }
  .cities-grid { list-style: none; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
  .city-card { background: var(--bg2); border: 1px solid var(--border); border-radius: 16px; padding: 2rem; transition: border-color 0.2s, transform 0.2s; }
  .city-card:hover { border-color: var(--accent-border); transform: translateY(-2px); }
  .city-pin { color: var(--accent-l); margin-bottom: 1rem; }
  .city-name { font-size: 1.2rem; font-weight: 800; margin-bottom: 0.3rem; }
  .city-sub { font-size: 0.72rem; color: var(--accent-l); text-transform: uppercase; letter-spacing: 0.08em; font-weight: 600; margin-bottom: 0.85rem; }
  .city-desc { font-size: 0.875rem; color: var(--muted); line-height: 1.6; }

  /* FAQ */
  .faq-section { background: var(--bg2); }
  .faq-list { max-width: 800px; margin: 0 auto; display: flex; flex-direction: column; gap: 0.75rem; }
  .faq-item { background: var(--bg); border: 1px solid var(--border); border-radius: 12px; overflow: hidden; transition: border-color 0.2s; }
  .faq-item:hover { border-color: var(--accent-border); }
  .faq-q { display: flex; justify-content: space-between; align-items: center; padding: 1.2rem 1.5rem; cursor: pointer; gap: 1rem; list-style: none; font-size: 0.95rem; font-weight: 600; user-select: none; }
  .faq-q::-webkit-details-marker { display: none; }
  .faq-icon { width: 28px; height: 28px; flex-shrink: 0; background: rgba(124,58,237,0.1); border: 1px solid var(--accent-border); border-radius: 6px; display: flex; align-items: center; justify-content: center; font-size: 1.1rem; color: var(--accent-l); transition: background 0.2s; }
  details[open] .faq-icon { background: rgba(124,58,237,0.2); }
  .faq-a { padding: 0 1.5rem 1.25rem; font-size: 0.9rem; color: var(--muted); line-height: 1.75; }

  /* Blog */
  .posts-grid { list-style: none; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; margin-bottom: 2.5rem; }
  .post-card { background: var(--bg2); border: 1px solid var(--border); border-radius: 16px; overflow: hidden; transition: border-color 0.2s, transform 0.2s; }
  .post-card:hover { border-color: var(--accent-border); transform: translateY(-3px); }
  .post-link { display: block; text-decoration: none; color: inherit; }
  .post-img { width: 100%; height: 175px; object-fit: cover; display: block; }
  .post-body { padding: 1.4rem; }
  .post-tags { display: flex; flex-wrap: wrap; gap: 0.35rem; margin-bottom: 0.7rem; }
  .post-tag { background: rgba(124,58,237,0.1); color: var(--accent-l); font-size: 0.62rem; font-weight: 700; padding: 0.2rem 0.6rem; border-radius: 9999px; text-transform: uppercase; letter-spacing: 0.06em; }
  .post-title { font-size: 0.98rem; font-weight: 700; line-height: 1.4; margin-bottom: 0.5rem; }
  .post-desc { font-size: 0.845rem; color: var(--muted); line-height: 1.55; margin-bottom: 0.9rem; }
  .post-date { font-size: 0.76rem; color: var(--muted); }
  .blog-cta { text-align: center; }

  /* CTA */
  .cta-section { padding: 8rem 0; }
