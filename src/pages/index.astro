---
import { getCollection } from 'astro:content';
import GTMHead from '../components/GTMHead.astro';
import GTMBody from '../components/GTMBody.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import MetaPixel from '../components/MetaPixel.astro';
import EventTracking from '../components/EventTracking.astro';

const allPosts = await getCollection('blog');
const recentPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
const siteURL = Astro.site?.href ?? 'https://smartops-ia.com.br';

const whatsappNumber = '5531972039180';
const whatsappMsg = encodeURIComponent('Olá! Vim pelo site da SmartOps IA e quero saber mais sobre os serviços.');
const whatsappURL = `https://wa.me/${whatsappNumber}?text=${whatsappMsg}`;

function formatDate(date: Date) {
  return date.toLocaleDateString('pt-BR', { year: 'numeric', month: 'short', day: 'numeric' });
}

// schema definido após os arrays de dados (serviços, FAQ)

const services = [
  {
    id: 'diagnostico-smart',
    icon: `<circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/><path d="M11 8v6M8 11h6"/>`,
    title: 'Diagnóstico SMART Avançado',
    desc: 'Análise completa dos parâmetros SMART de HDs e SSDs com CrystalDiskInfo, smartctl, HD Tune e Victoria. Identificamos bad blocks e risco de falha antes que você perca seus dados.',
  },
  {
    id: 'upgrade-ssd',
    icon: `<polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>`,
    title: 'Upgrade SSD M.2 / SATA',
    desc: 'Instalação e clonagem do sistema operacional para SSD NVMe ou SATA. Boot de 4 minutos vai para 12 segundos. 3.500 MB/s de velocidade. Garantia de funcionamento.',
  },
  {
    id: 'formatacao',
    icon: `<rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/>`,
    title: 'Formatação Completa',
    desc: 'Formatação e reinstalação do Windows com drivers, programas essenciais e configurações otimizadas. Backup completo e verificado antes de qualquer procedimento.',
  },
  {
    id: 'remocao-virus',
    icon: `<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>`,
    title: 'Remoção de Vírus',
    desc: 'Eliminação completa de malware, ransomware, adware e spyware. Verificação em múltiplas camadas. Sistema limpo e protegido garantido.',
  },
  {
    id: 'lean-six-sigma',
    icon: `<line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/>`,
    title: 'Consultoria Lean Six Sigma',
    desc: 'Black Belt em Lean Six Sigma aplicado à melhoria de processos em TI e negócios. Reduza desperdícios, automatize com IA e aumente a eficiência da sua operação.',
  },
  {
    id: 'limpeza-manutencao',
    icon: `<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>`,
    title: 'Limpeza & Manutenção',
    desc: 'Limpeza interna com ar comprimido, troca de pasta térmica e verificação de dissipadores. Temperatura reduzida, vida útil ampliada, performance restaurada.',
  },
];

const problems = [
  { icon: '🐌', label: 'PC Lento',          id: 'pc-lento' },
  { icon: '💙', label: 'Tela Azul (BSOD)',  id: 'tela-azul' },
  { icon: '🦠', label: 'Vírus / Malware',   id: 'virus' },
  { icon: '🔥', label: 'Superaquecimento',  id: 'superaquecimento' },
  { icon: '💾', label: 'HD com Barulho',    id: 'hd-barulho' },
  { icon: '🔒', label: 'PC Travando',       id: 'pc-travando' },
  { icon: '🚫', label: 'Não Liga',          id: 'nao-liga' },
  { icon: '📉', label: 'FPS Baixo',         id: 'fps-baixo' },
  { icon: '⏰', label: 'Boot Lento',        id: 'boot-lento' },
  { icon: '⚠️', label: 'Erros SMART',      id: 'erros-smart' },
  { icon: '📁', label: 'Arquivos Sumindo',  id: 'arquivos-sumindo' },
  { icon: '🔇', label: 'Sem Áudio',         id: 'sem-audio' },
];

const testimonials = [
  {
    stars: 5,
    text: 'Meu notebook demorava 6 minutos para ligar. Depois do upgrade de SSD, está iniciando em menos de 15 segundos. Parece um computador novo! Diagnóstico foi feito na hora, mostrou tudo certinho.',
    name: 'Ana Carolina M.',
    role: 'Arquiteta · Upgrade SSD',
  },
  {
    stars: 5,
    text: 'O técnico mostrou na tela os erros SMART do meu HD. Nunca tinha visto isso antes. O HD estava praticamente morto e eu não sabia. Conseguiu recuperar todos meus arquivos antes de trocar.',
    name: 'Roberto F.',
    role: 'Contador · Recuperação de HD',
  },
  {
    stars: 5,
    text: 'PC gamer travando nos jogos. Descobriu que era superaquecimento da GPU e HD com bad blocks. Resolveu os dois, agora roda tudo no máximo sem travar. Serviço sério e técnico muito honesto.',
    name: 'Lucas S.',
    role: 'Gamer · Diagnóstico + Setup',
  },
];

const faqs = [
  {
    q: 'O que é análise SMART e por que é importante?',
    a: 'SMART é um sistema interno de monitoramento que todos os HDs e SSDs modernos possuem. Ele registra parâmetros como setores defeituosos, erros de leitura, temperatura e horas de uso. Analisando esses dados, identificamos falhas iminentes antes que você perca seus dados — algo que não é possível apenas "olhando" o computador.',
  },
  {
    q: 'Vale a pena colocar SSD? Qual a diferença real?',
    a: 'Sim, é o melhor upgrade que você pode fazer. Um HD mecânico lê dados a cerca de 80–120 MB/s. Um SSD NVMe atinge 3.500 MB/s — 40 vezes mais rápido. Na prática: boot que demorava 4 minutos passa para 12 segundos. Chrome que demorava 18 segundos abre em menos de 2.',
  },
  {
    q: 'Quanto tempo demora uma formatação?',
    a: 'Uma formatação completa, incluindo backup, instalação do Windows, drivers e programas essenciais, normalmente leva entre 3 a 6 horas dependendo da configuração. Trabalhamos para não deixar você sem o computador por mais de 1 dia útil na maioria dos casos.',
  },
  {
    q: 'Meus arquivos ficam seguros na formatação?',
    a: 'Sempre. Antes de qualquer procedimento, realizamos backup completo e verificado dos seus arquivos. Você recebe confirmação do que foi salvo antes de prosseguirmos. Não formatamos nada sem a sua aprovação explícita.',
  },
  {
    q: 'Vocês fazem atendimento remoto?',
    a: 'Sim, para problemas de software, lentidão, vírus, configurações e otimizações. O atendimento remoto é feito com acesso via ferramentas seguras, com sua autorização em tempo real. Você vê tudo o que está sendo feito na tela.',
  },
  {
    q: 'O diagnóstico é gratuito?',
    a: 'O diagnóstico inicial via WhatsApp é feito gratuitamente — você descreve os sintomas e já recebe uma análise preliminar. O diagnóstico técnico completo com leitura SMART pode ser incluído no valor do serviço quando você opta pelo reparo.',
  },
];

const cities = [
  { name: 'Nova Pampulha', sub: 'Belo Horizonte, MG', desc: 'Manutenção, upgrade de SSD, automação e SEO para negócios da região.' },
  { name: 'Morro Alto', sub: 'Região Metropolitana, MG', desc: 'Diagnóstico avançado, formatação e suporte técnico para pessoas e empresas.' },
  { name: 'Vespasiano', sub: 'Região Metropolitana de BH', desc: 'SEO local, manutenção de computadores e consultoria em IA e processos.' },
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    // ── LocalBusiness + ProfessionalService ──────────────────────────────
    {
      '@type': ['LocalBusiness', 'ProfessionalService'],
      '@id': `${siteURL}#business`,
      name: 'SmartOps IA',
      alternateName: 'SmartOps SEO',
      description: 'Manutenção de computadores, diagnóstico SMART avançado, upgrade SSD, formatação, remoção de vírus, automação com IA e SEO local em Belo Horizonte e região.',
      url: siteURL,
      telephone: '+55-31-97203-9180',
      priceRange: '$$',
      image: new URL('/og-default.svg', siteURL).href,
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Belo Horizonte',
        addressRegion: 'MG',
        addressCountry: 'BR',
      },
      areaServed: [
        { '@type': 'City', name: 'Nova Pampulha', containedInPlace: { '@type': 'City', name: 'Belo Horizonte' } },
        { '@type': 'City', name: 'Morro Alto' },
        { '@type': 'City', name: 'Vespasiano' },
        { '@type': 'AdministrativeArea', name: 'Região Metropolitana de Belo Horizonte' },
      ],
      openingHoursSpecification: [
        {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
          opens: '08:00',
          closes: '18:00',
        },
        {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: 'Saturday',
          opens: '08:00',
          closes: '13:00',
        },
      ],
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Serviços SmartOps IA',
        itemListElement: services.map((s, i) => ({
          '@type': 'Offer',
          position: i + 1,
          itemOffered: {
            '@type': 'Service',
            name: s.title,
            description: s.desc,
            provider: { '@id': `${siteURL}#business` },
          },
        })),
      },
      contactPoint: {
        '@type': 'ContactPoint',
        telephone: '+55-31-97203-9180',
        contactType: 'customer service',
        availableLanguage: { '@type': 'Language', name: 'Portuguese' },
      },
      sameAs: [`https://wa.me/${whatsappNumber}`],
    },
    // ── Organization ─────────────────────────────────────────────────────
    {
      '@type': 'Organization',
      '@id': `${siteURL}#organization`,
      name: 'SmartOps IA',
      url: siteURL,
      logo: {
        '@type': 'ImageObject',
        url: new URL('/favicon.svg', siteURL).href,
        width: 512,
        height: 512,
      },
      sameAs: [`https://wa.me/${whatsappNumber}`],
    },
    // ── WebSite ───────────────────────────────────────────────────────────
    {
      '@type': 'WebSite',
      '@id': `${siteURL}#website`,
      url: siteURL,
      name: 'SmartOps IA',
      description: 'Manutenção de computadores, diagnóstico SMART, upgrade SSD, automação com IA e SEO local em Belo Horizonte e região.',
      inLanguage: 'pt-BR',
      publisher: { '@id': `${siteURL}#organization` },
    },
    // ── WebPage ───────────────────────────────────────────────────────────
    {
      '@type': 'WebPage',
      '@id': `${canonicalURL}#webpage`,
      url: canonicalURL,
      name: 'SmartOps IA — Diagnóstico, Manutenção, SSD e Automação em BH',
      description: 'Diagnóstico SMART avançado, upgrade SSD, formatação, remoção de vírus, automação com IA e SEO local. Atendimento em Nova Pampulha, Morro Alto e Vespasiano.',
      inLanguage: 'pt-BR',
      isPartOf: { '@id': `${siteURL}#website` },
      about: { '@id': `${siteURL}#business` },
      breadcrumb: {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: siteURL },
        ],
      },
    },
    // ── FAQPage — rich snippets Q&A no Google ────────────────────────────
    {
      '@type': 'FAQPage',
      '@id': `${canonicalURL}#faq`,
      mainEntity: faqs.map(faq => ({
        '@type': 'Question',
        name: faq.q,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.a,
        },
      })),
    },
  ],
};
---

<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Preconnect para domínios críticos de terceiros -->
    <link rel="preconnect" href="https://www.googletagmanager.com" />
    <link rel="preconnect" href="https://www.google-analytics.com" />
    <link rel="dns-prefetch" href="https://connect.facebook.net" />

    <GTMHead />
    <MetaPixel />

    <title>SmartOps IA — Diagnóstico, Manutenção, SSD e Automação em BH</title>
    <meta name="description" content="Diagnóstico SMART avançado, upgrade SSD, formatação, remoção de vírus, automação com IA e SEO local. Atendimento em Nova Pampulha, Morro Alto e Vespasiano." />
    <meta name="keywords" content="manutenção computadores, diagnóstico SMART, upgrade SSD, formatação, vírus, automação IA, SEO local, Nova Pampulha, Vespasiano, Belo Horizonte, Lean Six Sigma" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content="SmartOps IA — Diagnóstico, Manutenção, SSD e Automação" />
    <meta property="og:description" content="Diagnóstico SMART avançado, upgrade SSD, formatação e automação com IA. Atendimento em Nova Pampulha, Morro Alto e Vespasiano." />
    <meta property="og:image" content={new URL('/og-default.svg', Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="SmartOps IA" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="SmartOps IA — Diagnóstico, Manutenção, SSD e Automação" />
    <meta name="twitter:description" content="Diagnóstico SMART avançado, upgrade SSD, formatação e automação com IA." />
    <meta name="twitter:image" content={new URL('/og-default.svg', Astro.site).href} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />

    <GoogleAnalytics />
  </head>

  <body>
    <GTMBody />

    <!-- ── FLOAT WHATSAPP ── -->
    <a href={whatsappURL} class="wpp-float" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp" data-event="clique_whatsapp" data-location="float" data-label="Botão Flutuante">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="white" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.127.558 4.122 1.532 5.856L0 24l6.335-1.611A11.945 11.945 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.818 9.818 0 0 1-5.003-1.372l-.359-.214-3.723.947.985-3.596-.235-.369A9.818 9.818 0 1 1 12 21.818z"/></svg>
    </a>

    <!-- ── NAVBAR ── -->
    <header>
      <nav>
        <a href="/" class="logo" aria-current="page">
          Smart<span>Ops</span> <em>IA</em>
        </a>
        <div class="nav-links" id="nav-links">
          <a href="/">Home</a>
          <a href="/lean-six-sigma">Lean Six Sigma</a>
          <a href="/automacao">Automação com IA</a>
          <a href="/blog">Blog</a>
          <a href="/sobre">Sobre</a>
        </div>
        <a href={whatsappURL} class="nav-wa" target="_blank" rel="noopener noreferrer" data-event="clique_whatsapp" data-location="navbar" data-label="Falar agora">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.127.558 4.122 1.532 5.856L0 24l6.335-1.611A11.945 11.945 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.818 9.818 0 0 1-5.003-1.372l-.359-.214-3.723.947.985-3.596-.235-.369A9.818 9.818 0 1 1 12 21.818z"/></svg>
          Falar agora
        </a>
        <button class="mobile-toggle" id="mobile-toggle" aria-label="Abrir menu" aria-expanded="false">
          <span></span><span></span><span></span>
        </button>
      </nav>
    </header>

    <main>

      <!-- ── HERO ── -->
      <section class="hero">
        <div class="hero-glow" aria-hidden="true"></div>
        <div class="container hero-inner">
          <div class="hero-badge">
            <span class="badge-dot" aria-hidden="true"></span>
            Black Belt Lean Six Sigma · Belo Horizonte, MG
          </div>
          <h1>
            Lean Six Sigma e<br />
            <span class="gradient-text">Automação com IA</span><br />
            para pequenas empresas
          </h1>
          <p class="hero-sub">
            Eliminamos desperdícios e automatizamos processos repetitivos para que sua equipe foque no que gera resultado. Método comprovado, linguagem de negócio — sem academicismo.
          </p>
          <div class="hero-btns">
            <a href={whatsappURL} class="btn-wa" target="_blank" rel="noopener noreferrer" data-event="clique_whatsapp" data-location="hero" data-label="Diagnóstico Grátis">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.127.558 4.122 1.532 5.856L0 24l6.335-1.611A11.945 11.945 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.818 9.818 0 0 1-5.003-1.372l-.359-.214-3.723.947.985-3.596-.235-.369A9.818 9.818 0 1 1 12 21.818z"/></svg>
              Diagnóstico Grátis
            </a>
            <a href="/#servicos" class="btn-outline">
              Ver Serviços
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          </div>
          <div class="hero-stats">
            <div class="hero-stat"><strong>Black Belt</strong><span>Lean Six Sigma</span></div>
            <div class="hero-stat-sep" aria-hidden="true"></div>
            <div class="hero-stat"><strong>-30%</strong><span>Custo operacional médio</span></div>
            <div class="hero-stat-sep" aria-hidden="true"></div>
            <div class="hero-stat"><strong>24h</strong><span>1º atendimento</span></div>
            <div class="hero-stat-sep" aria-hidden="true"></div>
            <div class="hero-stat"><strong>BH</strong><span>Belo Horizonte, MG</span></div>
          </div>
        </div>
      </section>

      <!-- ── PROBLEMAS ── -->
      <section class="section problems-section">
        <div class="container">
          <div class="section-header">
            <p class="section-label">Reconhece algum desses?</p>
            <h2 class="section-title">Problemas que <span class="gradient-text">resolvemos agora</span></h2>
          </div>
          <ul class="problems-grid">
            {problems.map(p => (
              <li class="problem-tile" data-modal={`prob-${p.id}`} role="button" tabindex="0">
                <span class="problem-icon" aria-hidden="true">{p.icon}</span>
                <span class="problem-label">{p.label}</span>
                <span class="problem-hint" aria-hidden="true">→</span>
              </li>
            ))}
          </ul>
          <div class="problems-cta">
            <div>
              <strong>Se seu PC apresenta qualquer um desses sinais, não ignore.</strong>
              <p>Alguns problemas evoluem rápido e podem resultar em perda total de dados. Diagnóstico identifica a causa real.</p>
