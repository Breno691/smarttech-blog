    <script is:inline>
    (function () {
      'use strict';
      var WEBHOOK_URL = 'https://n8n-n8nn.sumjyb.easypanel.host/webhook/captura-leads';
      var WA = '5531972039180';

      var form = document.getElementById('lead-form');
      var successEl = document.getElementById('lead-success');
      var errorEl = document.getElementById('lead-error');
      if (!form || !successEl || !errorEl) return;

      var retryBtn = document.getElementById('lead-retry');
      if (retryBtn) {
        retryBtn.addEventListener('click', function () {
          errorEl.hidden = true;
          form.hidden = false;
          form.querySelector('[name="nome"]').focus();
        });
      }

      var started = false;
      form.addEventListener('focusin', function () {
        if (started) return;
        started = true;
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ event: 'lead_formulario', event_location: 'lead-form' });
      });

      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var nome = form.nome.value.trim();
        var telefone = form.telefone.value.trim();
        var servico = form.servico.value;

        ['nome', 'telefone', 'servico'].forEach(function (f) { form[f].removeAttribute('aria-invalid'); });

        var valid = true;
        if (!nome) { form.nome.setAttribute('aria-invalid', 'true'); valid = false; }
        if (!telefone) { form.telefone.setAttribute('aria-invalid', 'true'); valid = false; }
        if (!servico) { form.servico.setAttribute('aria-invalid', 'true'); valid = false; }
        if (!valid) { form.querySelector('[aria-invalid="true"]').focus(); return; }

        var payload = {
          nome: nome, telefone: telefone,
          empresa: form.empresa.value.trim(),
          servico: servico,
          mensagem: form.mensagem.value.trim(),
          origem: window.location.href,
          timestamp: new Date().toISOString(),
        };

        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ event: 'envio_formulario', event_location: 'lead-form', event_label: payload.servico });
        if (typeof fbq === 'function') fbq('track', 'SubmitApplication');

        var btn = form.querySelector('.btn-lead');
        btn.disabled = true;
        btn.classList.add('is-loading');

        function onSuccess() {
          window.dataLayer.push({ event: 'lead_gerado', event_location: 'lead-form', event_label: payload.servico });
          if (typeof fbq === 'function') fbq('track', 'Lead', { content_name: payload.servico });
          form.hidden = true;
          successEl.hidden = false;
          successEl.focus();
        }

        function fallbackWA() {
          var lines = ['Olá! Quero um diagnóstico gratuito.', '', 'Nome: ' + payload.nome, 'Telefone: ' + payload.telefone];
          if (payload.empresa) lines.push('Empresa: ' + payload.empresa);
          lines.push('Serviço: ' + payload.servico);
          if (payload.mensagem) lines.push('', payload.mensagem);
          window.open('https://wa.me/' + WA + '?text=' + encodeURIComponent(lines.join('\n')), '_blank');
          onSuccess();
        }

        var timeout = new Promise(function (_, reject) { setTimeout(function () { reject(new Error('timeout')); }, 8000); });

        Promise.race([
          fetch(WEBHOOK_URL, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) })
            .then(function (r) { if (!r.ok) throw new Error(r.status); }),
          timeout,
        ]).then(onSuccess).catch(function () {
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({ event: 'erro_formulario_fallback', event_location: 'lead-form', event_label: payload.servico });
          fallbackWA();
        });
      });
    })();
    </script>

