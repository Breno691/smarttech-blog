    (function () {
      'use strict';
      // Alterna os rótulos do painel do Gêmeo Digital entre linguagem de
      // negócio (padrão, pro dono de padaria/clínica entender) e o jargão
      // técnico original (CTQ, PCE, SLA Compliance...) — só troca texto,
      // não mexe na animação em si.
      var buttons = document.querySelectorAll('.twin-view-btn');
      var labeledEls = document.querySelectorAll('#digital-twin-charter [data-label-tech], #digital-twin-baseline [data-label-tech], #digital-twin-rootcause [data-label-tech], #digital-twin-futurestate [data-label-tech], #digital-twin-continuous [data-label-tech], #digital-twin-logs [data-label-tech]');
      if (!buttons.length || !labeledEls.length) return;

      labeledEls.forEach(function (el) {
        el.dataset.labelBiz = el.textContent || '';
      });

      function setView(view) {
        labeledEls.forEach(function (el) {
          el.textContent = view === 'tech' ? el.dataset.labelTech : el.dataset.labelBiz;
        });
        buttons.forEach(function (btn) {
          btn.classList.toggle('is-active', btn.dataset.view === view);
        });
      }

      buttons.forEach(function (btn) {
        btn.addEventListener('click', function () { setView(btn.dataset.view); });
      });
    })();
    </script>

