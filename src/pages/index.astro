  /* ── GÊMEO DIGITAL (Fase 8, nova seção) ── */
  .twin-section { background: rgba(13,13,28,0.94); position: relative; overflow: hidden; }
  .twin-inner { position: relative; }
  /* v4 "Digital War Room" — dark mode corporativo (azul/cinza/ciano/vermelho),
