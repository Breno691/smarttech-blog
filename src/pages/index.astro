<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --bg: #06060e;
    --bg2: #0d0d1c;
    --bg3: #13132a;
    --fg: #e8e8f0;
    --muted: #8b8baa;
    --accent: #7c3aed;
    --accent-l: #a78bfa;
    --accent-glow: rgba(124, 58, 237, 0.25);
    --accent-border: rgba(167, 139, 250, 0.18);
    --green: #25d366;
    --green-h: #1db954;
    --border: rgba(255, 255, 255, 0.07);
    --max-w: 1180px;
    --font: -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
  }

  html { scroll-behavior: smooth; }
  body { font-family: var(--font); background: var(--bg); color: var(--fg); line-height: 1.7; overflow-x: hidden; }
  /* Next Level UI — só fica transparente depois que o shader de fundo confirma
     que está rodando (classe via JS em background-webgl.ts). Sem essa classe
     (celular, ou se o WebGL falhar por qualquer motivo), o body mantém o fundo
     escuro sólido de sempre — nunca aparece uma tela quebrada/branca. */
  html.webgl-bg-active body { background: transparent; }

  /* Next Level UI Fase 4 — cursor customizado. Só esconde o cursor nativo
     depois que magnetic-cursor.ts confirma que o substituto já está no DOM
     (classe via JS) — sem isso (celular, ou falha do JS), o cursor do
     sistema continua normal, nunca fica "sem cursor nenhum". */
  html.magnetic-cursor-active, html.magnetic-cursor-active * { cursor: none !important; }
  .magnetic-cursor {
    position: fixed;
    top: 0;
    left: 0;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--accent-l);
    box-shadow: 0 0 12px 2px var(--accent-glow), 0 0 24px 6px rgba(124, 58, 237, 0.25);
    pointer-events: none;
    z-index: 9999;
    opacity: 0;
    transition: opacity 0.2s ease, width 0.25s ease, height 0.25s ease, background 0.25s ease, border 0.25s ease;
    will-change: transform;
  }
  .magnetic-cursor.is-visible { opacity: 1; }
  .magnetic-cursor.is-active {
    width: 40px;
    height: 40px;
    background: transparent;
    border: 2px solid var(--accent-l);
    box-shadow: 0 0 20px 4px var(--accent-glow);
  }

  .container { max-width: var(--max-w); margin: 0 auto; padding: 0 2rem; }

  .gradient-text {
    background: linear-gradient(135deg, var(--accent-l) 0%, var(--accent) 60%);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
  }

  /* Float WPP */
  .wpp-float {
    position: fixed; bottom: 28px; right: 28px; z-index: 500;
    width: 58px; height: 58px; background: var(--green); border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 4px 28px rgba(37,211,102,0.5); transition: transform 0.3s, box-shadow 0.3s; text-decoration: none;
  }
  .wpp-float:hover { transform: scale(1.1); box-shadow: 0 6px 40px rgba(37,211,102,0.7); }

  /* Buttons */
  .btn-wa {
    display: inline-flex; align-items: center; gap: 0.6rem;
    /* Verde mais escuro que --green só aqui: texto branco em cima do verde
       claro do WhatsApp não batia o contraste mínimo (achado real do
       PageSpeed, 12/set/2026) — o resto do site que usa --green continua
       igual, esse ajuste é só pro botão com texto por cima. */
    background: #128040; color: #fff; font-weight: 700; font-size: 1rem;
