---
import { getCollection } from 'astro:content';
import GTMHead from '../components/GTMHead.astro';
import GTMBody from '../components/GTMBody.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import MetaPixel from '../components/MetaPixel.astro';
import EventTracking from '../components/EventTracking.astro';

const allPosts = await getCollection('blog');
const recentPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
const siteURL = Astro.site?.href ?? 'https://smartops-ia.com.br';

const whatsappNumber = '5531972039180';
const whatsappMsg = encodeURIComponent('Olá! Vim pelo site da SmartOps IA e quero saber mais sobre os serviços.');
const whatsappURL = `https://wa.me/${whatsappNumber}?text=${whatsappMsg}`;

function formatDate(date: Date) {
  return date.toLocaleDateString('pt-BR', { year: 'numeric', month: 'short', day: 'numeric' });
}

const testimonials = [
  {
    stars: 5,
    text: 'Eram 3 meses tentando resolver o retrabalho no atendimento. Em 4 semanas com o método Lean o processo ficou padronizado e o time parou de perguntar o que fazer. Resultado real, não promessa.',
    name: 'Fernanda O.',
    role: 'Diretora · Clínica Odontológica · Lean Six Sigma',
  },
  {
    stars: 5,
    text: 'Automatizamos o atendimento no WhatsApp com IA. Hoje o sistema responde clientes às 3h da manhã, qualifica e agenda. A equipe só pega casos que realmente precisam de atenção.',
    name: 'Rodrigo M.',
    role: 'Empresário · Serviços · Automação com IA',
  },
  {
    stars: 5,
    text: 'Meu notebook demorava 6 minutos para ligar. Depois do upgrade de SSD, está iniciando em menos de 15 segundos. Diagnóstico na hora, mostrou exatamente o problema antes de tocar em nada.',
    name: 'Ana Carolina M.',
    role: 'Arquiteta · Upgrade SSD · Nova Pampulha',
  },
];

const faqs = [
  {
    q: 'Por onde começo — Lean Six Sigma ou automação?',
    a: 'Sempre pelo Lean primeiro. Automatizar um processo ruim só faz você errar mais rápido. A sequência certa é: mapear o processo, eliminar os desperdícios, padronizar — só então automatizar o que funciona bem. As duas metodologias juntas multiplicam o resultado.',
  },
  {
    q: 'Lean Six Sigma funciona para empresa pequena?',
    a: 'Funciona especialmente bem. Grande empresa tem folga para absorver desperdício. Pequena empresa não tem. Cada hora perdida em retrabalho, cada processo sem padrão, cada cliente sem resposta — isso é dinheiro real saindo do caixa todo mês. O Lean identifica e elimina esses pontos com método.',
  },
  {
    q: 'Em quanto tempo vejo resultado?',
    a: 'Quick wins de Lean aparecem nas primeiras 2–4 semanas. Automações simples (WhatsApp com IA) ficam prontas em 1–2 semanas. Projetos mais completos levam de 6 a 12 semanas. Em todos os casos, você acompanha indicadores reais durante o processo — não é caixa preta.',
  },
  {
    q: 'Vocês atendem só presencialmente?',
    a: 'Lean Six Sigma e Automação com IA são atendidos presencialmente ou remotamente — a maior parte do trabalho acontece em reuniões focadas e na análise dos dados do seu processo. Manutenção & TI (computadores, SSD, formatação) é presencial, atendendo Nova Pampulha e Morro Alto.',
  },
  {
    q: 'O diagnóstico inicial tem custo?',
    a: 'Não. A conversa inicial de 30 minutos é gratuita. Você descreve o problema, e na conversa já entregamos uma análise preliminar: onde está o gargalo real, o que causa o retrabalho, qual o caminho mais rápido para resolver. Só avançamos se fizer sentido para os dois lados.',
  },
  {
    q: 'Como é cobrado o serviço?',
    a: 'Cada projeto tem escopo e valor fechado antes de começar — sem surpresa no meio. Você recebe proposta clara com o que será feito, em quanto tempo, qual o resultado esperado e quanto custa. Só começa quando você aprovar.',
  },
];

const cities = [
  { name: 'Nova Pampulha', sub: 'Belo Horizonte, MG', desc: 'Manutenção & TI presencial · Lean Six Sigma · Automação com IA — atendimento completo na região.' },
  { name: 'Morro Alto', sub: 'Região Metropolitana, MG', desc: 'Manutenção & TI presencial · Lean Six Sigma · Automação com IA — todos os serviços disponíveis.' },
  { name: 'Belo Horizonte', sub: 'BH e Grande BH', desc: 'Lean Six Sigma e Automação com IA para empresas em toda BH. Consultoria presencial ou remota.' },
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['LocalBusiness', 'ProfessionalService'],
      '@id': `${siteURL}#business`,
      name: 'SmartOps IA',
      description: 'Lean Six Sigma, automação com IA e manutenção de computadores para pequenas empresas em BH, Nova Pampulha e Morro Alto.',
      url: siteURL,
      telephone: '+55-31-97203-9180',
      priceRange: '$$',
      image: new URL('/og-default.svg', siteURL).href,
      address: { '@type': 'PostalAddress', addressLocality: 'Belo Horizonte', addressRegion: 'MG', addressCountry: 'BR' },
      areaServed: [
        { '@type': 'City', name: 'Belo Horizonte' },
        { '@type': 'Place', name: 'Nova Pampulha', containedInPlace: { '@type': 'City', name: 'Belo Horizonte' } },
        { '@type': 'Place', name: 'Morro Alto' },
      ],
      openingHoursSpecification: [
        { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday','Tuesday','Wednesday','Thursday','Friday'], opens: '08:00', closes: '18:00' },
        { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Saturday', opens: '08:00', closes: '13:00' },
      ],
      contactPoint: { '@type': 'ContactPoint', telephone: '+55-31-97203-9180', contactType: 'customer service', availableLanguage: { '@type': 'Language', name: 'Portuguese' } },
      sameAs: [`https://wa.me/${whatsappNumber}`],
    },
    {
      '@type': 'Organization',
      '@id': `${siteURL}#organization`,
      name: 'SmartOps IA',
      url: siteURL,
      logo: { '@type': 'ImageObject', url: new URL('/favicon.svg', siteURL).href, width: 512, height: 512 },
      sameAs: [`https://wa.me/${whatsappNumber}`],
    },
    {
      '@type': 'WebSite',
      '@id': `${siteURL}#website`,
      url: siteURL,
      name: 'SmartOps IA',
      description: 'Lean Six Sigma, automação com IA e manutenção de computadores em BH, Nova Pampulha e Morro Alto.',
      inLanguage: 'pt-BR',
      publisher: { '@id': `${siteURL}#organization` },
    },
    {
      '@type': 'WebPage',
      '@id': `${canonicalURL}#webpage`,
      url: canonicalURL,
      name: 'SmartOps IA — Lean Six Sigma, Automação com IA e Manutenção em BH',
      description: 'Lean Six Sigma e Automação com IA para pequenas empresas em BH, Nova Pampulha e Morro Alto. Manutenção & TI presencial em Nova Pampulha e Morro Alto.',
      inLanguage: 'pt-BR',
      isPartOf: { '@id': `${siteURL}#website` },
      about: { '@id': `${siteURL}#business` },
      breadcrumb: { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: siteURL }] },
    },
    {
      '@type': 'FAQPage',
      '@id': `${canonicalURL}#faq`,
      mainEntity: faqs.map(faq => ({ '@type': 'Question', name: faq.q, acceptedAnswer: { '@type': 'Answer', text: faq.a } })),
    },
  ],
};
---

<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://www.googletagmanager.com" />
    <link rel="preconnect" href="https://www.google-analytics.com" />
    <link rel="dns-prefetch" href="https://connect.facebook.net" />
    <GTMHead />
    <MetaPixel />

    <title>SmartOps IA — Lean Six Sigma, Automação com IA e Manutenção em BH</title>
    <meta name="description" content="Lean Six Sigma e Automação com IA para pequenas empresas em BH, Nova Pampulha e Morro Alto. Manutenção & TI presencial em Nova Pampulha e Morro Alto. Diagnóstico gratuito." />
    <meta name="keywords" content="lean six sigma belo horizonte, automação com IA, manutenção computadores nova pampulha, consultoria processos BH, n8n belo horizonte, upgrade SSD, formatação computador" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content="SmartOps IA — Lean Six Sigma, Automação e Manutenção" />
    <meta property="og:description" content="Lean Six Sigma e Automação com IA para pequenas empresas. Manutenção & TI em Nova Pampulha e Morro Alto. Diagnóstico gratuito." />
    <meta property="og:image" content={new URL('/og-default.svg', Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="SmartOps IA" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="SmartOps IA — Lean Six Sigma, Automação e Manutenção" />
    <meta name="twitter:description" content="Lean Six Sigma e Automação com IA para pequenas empresas em BH." />
    <meta name="twitter:image" content={new URL('/og-default.svg', Astro.site).href} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
    <GoogleAnalytics />
  </head>

  <body>
    <GTMBody />

    <!-- Float WhatsApp -->
    <a href={whatsappURL} class="wpp-float" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp" data-event="clique_whatsapp" data-location="float" data-label="Botão Flutuante">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="white" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.127.558 4.122 1.532 5.856L0 24l6.335-1.611A11.945 11.945 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.818 9.818 0 0 1-5.003-1.372l-.359-.214-3.723.947.985-3.596-.235-.369A9.818 9.818 0 1 1 12 21.818z"/></svg>
    </a>

    <!-- Nav -->
    <header>
      <nav>
        <a href="/" class="logo" aria-current="page">Smart<span>Ops</span> <em>IA</em></a>
        <div class="nav-links" id="nav-links">
          <a href="/">Home</a>
          <a href="/lean-six-sigma">Lean Six Sigma</a>
          <a href="/automacao">Automação com IA</a>
          <a href="/manutencao">Manutenção & TI</a>
          <a href="/blog">Blog</a>
          <a href="/sobre">Sobre</a>
        </div>
        <a href={whatsappURL} class="nav-wa" target="_blank" rel="noopener noreferrer" data-event="clique_whatsapp" data-location="navbar" data-label="Falar agora">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.127.558 4.122 1.532 5.856L0 24l6.335-1.611A11.945 11.945 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.818 9.818 0 0 1-5.003-1.372l-.359-.214-3.723.947.985-3.596-.235-.369A9.818 9.818 0 1 1 12 21.818z"/></svg>
          Falar agora
        </a>
        <button class="mobile-toggle" id="mobile-toggle" aria-label="Abrir menu" aria-expanded="false">
          <span></span><span></span><span></span>
        </button>
      </nav>
    </header>

    <main>

      <!-- ── HERO ── -->
      <section class="hero">
        <div class="hero-glow" aria-hidden="true"></div>
        <div class="container hero-inner">
          <div class="hero-text">
            <div class="hero-badge">
              <span class="badge-dot" aria-hidden="true"></span>
              Black Belt Lean Six Sigma · Belo Horizonte, MG
            </div>
            <h1>
              Lean Six Sigma e<br />
              <span class="gradient-text">Automação com IA</span><br />
              para pequenas empresas
            </h1>
            <p class="hero-sub">
              Eliminamos desperdícios e automatizamos processos repetitivos para que sua equipe foque no que gera resultado. Método comprovado, linguagem de negócio.
            </p>
            <div class="hero-btns">
              <a href={whatsappURL} class="btn-wa" target="_blank" rel="noopener noreferrer" data-event="clique_whatsapp" data-location="hero" data-label="Diagnóstico Grátis">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.127.558 4.122 1.532 5.856L0 24l6.335-1.611A11.945 11.945 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.818 9.818 0 0 1-5.003-1.372l-.359-.214-3.723.947.985-3.596-.235-.369A9.818 9.818 0 1 1 12 21.818z"/></svg>
                Diagnóstico Grátis
              </a>
              <a href="#servicos" class="btn-outline">
                Ver Serviços
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
            </div>
            <div class="hero-stats">
              <div class="hero-stat"><strong>Black Belt</strong><span>Lean Six Sigma</span></div>
              <div class="hero-stat-sep" aria-hidden="true"></div>
              <div class="hero-stat"><strong>−30%</strong><span>Custo operacional</span></div>
              <div class="hero-stat-sep" aria-hidden="true"></div>
              <div class="hero-stat"><strong>24h</strong><span>1º atendimento</span></div>
              <div class="hero-stat-sep" aria-hidden="true"></div>
              <div class="hero-stat"><strong>BH</strong><span>Belo Horizonte, MG</span></div>
            </div>
          </div>
          <div class="hero-visual" aria-hidden="true">
            <img src="/img/hero-home.svg" alt="" width="580" height="500" loading="eager" decoding="async" />
          </div>
        </div>
      </section>

      <!-- ── SERVIÇOS ── -->
      <section class="section services-section" id="servicos">
        <div class="container">
          <div class="section-header">
            <p class="section-label">O que fazemos</p>
            <h2 class="section-title">Três serviços, <span class="gradient-text">um objetivo</span></h2>
            <p class="section-sub">Método comprovado, tecnologia real e suporte técnico presencial. Cada serviço resolve um problema diferente.</p>
          </div>

          <div class="svc-layout">

            <!-- Featured: Lean + Automação -->
            <div class="svc-card svc-featured">
              <div class="svc-top">
                <div class="svc-pills">
                  <span class="svc-pill svc-pill-lean">Lean Six Sigma</span>
                  <span class="svc-plus">+</span>
                  <span class="svc-pill svc-pill-auto">Automação com IA</span>
                </div>
                <p class="svc-tag-note">Prioridade · BH, Nova Pampulha e Morro Alto</p>
              </div>

              <h3 class="svc-title">Quando a operação está presa no improviso</h3>
              <p class="svc-sub">Combinamos método Lean Six Sigma e tecnologia de IA para eliminar desperdícios e automatizar o que pode ser automatizado — na ordem certa.</p>

              <div class="svc-problems">
                <p class="svc-problems-label">Você reconhece algum desses problemas?</p>
                <ul class="svc-problems-list">
                  <li><span class="prob-x">✗</span> Equipe apagando incêndio todo dia, sem tempo para o que importa</li>
                  <li><span class="prob-x">✗</span> Retrabalho constante que ninguém consegue eliminar de vez</li>
                  <li><span class="prob-x">✗</span> WhatsApp caótico — clientes esperando horas sem resposta</li>
                  <li><span class="prob-x">✗</span> Operação que para quando o dono não está presente</li>
                  <li><span class="prob-x">✗</span> Cada pessoa faz o processo de um jeito diferente</li>
                  <li><span class="prob-x">✗</span> Quer crescer, mas a operação não aguenta mais volume</li>
                </ul>
              </div>

              <div class="svc-actions">
                <a href="/lean-six-sigma" class="svc-btn svc-btn-lean">
                  Lean Six Sigma
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </a>
                <a href="/automacao" class="svc-btn svc-btn-auto">
                  Automação com IA
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </a>
              </div>
            </div>

            <!-- Secondary: Manutenção & TI -->
            <a href="/manutencao" class="svc-card svc-side">
              <div class="svc-top">
                <div class="svc-pills">
                  <span class="svc-pill svc-pill-ti">Manutenção & TI</span>
                </div>
                <p class="svc-tag-note">Presencial · Nova Pampulha e Morro Alto</p>
              </div>

              <h3 class="svc-title">PC lento, vírus, SSD ou formatação?</h3>

              <ul class="svc-ti-list">
                <li>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                  Diagnóstico SMART — sabe o que está quebrando antes de quebrar
                </li>
                <li>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                  Upgrade SSD NVMe — boot de 4 min → <strong>12 segundos</strong>
                </li>
                <li>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                  Formatação completa com backup verificado antes de qualquer passo
                </li>
                <li>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                  Remoção de vírus, malware, limpeza térmica e otimização
                </li>
              </ul>

              <span class="svc-side-cta">Ver todos os serviços de TI →</span>
            </a>

          </div>
        </div>
      </section>

      <!-- ── LEAD CAPTURE ── -->
      <section class="lead-section" id="contato" aria-labelledby="lead-heading">
        <div class="container">
          <div class="lead-header">
            <p class="section-label">Diagnóstico gratuito</p>
            <h2 id="lead-heading">Processo travado, computador lento<br />ou <span class="gradient-text">operação no manual?</span></h2>
            <div class="lead-tags" aria-hidden="true">
              <span class="lead-tag lead-tag-lean">Lean Six Sigma</span>
              <span class="lead-tag-sep">·</span>
              <span class="lead-tag lead-tag-auto">Automação com IA</span>
              <span class="lead-tag-sep">·</span>
              <span class="lead-tag lead-tag-ti">Manutenção & TI</span>
            </div>
            <p class="lead-subtitle">Diagnóstico gratuito em 30 minutos — você sai sabendo o que fazer, por onde começar e quanto custa resolver.</p>
          </div>

          <div class="lead-grid">
            <div class="lead-col-form">
              <form id="lead-form" class="lead-form" novalidate autocomplete="on">
                <div class="form-row">
                  <div class="form-group">
                    <label for="lead-nome">Nome <span class="req" aria-hidden="true">*</span></label>
                    <input type="text" id="lead-nome" name="nome" required placeholder="Seu nome" autocomplete="name" maxlength="100" />
                  </div>
                  <div class="form-group">
                    <label for="lead-tel">WhatsApp <span class="req" aria-hidden="true">*</span></label>
                    <input type="tel" id="lead-tel" name="telefone" required placeholder="(31) 99999-9999" autocomplete="tel" maxlength="20" />
                  </div>
                </div>
                <div class="form-row">
                  <div class="form-group">
                    <label for="lead-empresa">Empresa</label>
                    <input type="text" id="lead-empresa" name="empresa" placeholder="Nome da empresa" autocomplete="organization" maxlength="100" />
                  </div>
                  <div class="form-group">
