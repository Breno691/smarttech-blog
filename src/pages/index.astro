      var WEBHOOK_URL = 'https://n8n-n8nn.sumjyb.easypanel.host/webhook/captura-leads';
      var WA = '5531972039180';

      var form = document.getElementById('lead-form');
      var successEl = document.getElementById('lead-success');
      var errorEl = document.getElementById('lead-error');
      if (!form || !successEl || !errorEl) return;

      var retryBtn = document.getElementById('lead-retry');
      if (retryBtn) {
        retryBtn.addEventListener('click', function () {
          errorEl.hidden = true;
          form.hidden = false;
          form.querySelector('[name="nome"]').focus();
        });
      }

      var started = false;
      form.addEventListener('focusin', function () {
        if (started) return;
        started = true;
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ event: 'lead_formulario', event_location: 'lead-form' });
      });

      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var nome = form.nome.value.trim();
        var telefone = form.telefone.value.trim();
        var servico = form.servico.value;

        ['nome', 'telefone', 'servico'].forEach(function (f) { form[f].removeAttribute('aria-invalid'); });

        var valid = true;
        if (!nome) { form.nome.setAttribute('aria-invalid', 'true'); valid = false; }
        if (!telefone) { form.telefone.setAttribute('aria-invalid', 'true'); valid = false; }
        if (!servico) { form.servico.setAttribute('aria-invalid', 'true'); valid = false; }
        if (!valid) { form.querySelector('[aria-invalid="true"]').focus(); return; }

        // event_id para deduplicação browser↔CAPI
        var leadEventId = 'lead_' + Date.now() + '_' + Math.random().toString(36).slice(2, 6);

        var payload = {
          nome: nome, telefone: telefone,
          empresa: form.empresa.value.trim(),
          servico: servico,
          mensagem: form.mensagem.value.trim(),
          origem: window.location.href,
          timestamp: new Date().toISOString(),
          event_id: leadEventId,  // CAPI deduplication
          fbp: (document.cookie.match(/_fbp=([^;]+)/) || [])[1] || undefined,
          fbc: (document.cookie.match(/_fbc=([^;]+)/) || [])[1] || undefined,
        };

        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ event: 'envio_formulario', event_location: 'lead-form', event_label: payload.servico });
        // FIX: Contact no envio + Lead no sucesso (melhor para otimização de campanha)
        if (typeof fbq === 'function') fbq('track', 'Contact', {}, { eventID: leadEventId });

        var btn = form.querySelector('.btn-lead');
        btn.disabled = true;
        btn.classList.add('is-loading');

        function onSuccess() {
          window.dataLayer.push({ event: 'lead_gerado', event_location: 'lead-form', event_label: payload.servico });
          // event_id idêntico ao do Contact → CAPI deduplica Lead corretamente
          if (typeof fbq === 'function') fbq('track', 'Lead', { content_name: payload.servico }, { eventID: leadEventId });
          form.hidden = true;
          successEl.hidden = false;
          successEl.focus();
        }

        function fallbackWA() {
          var lines = ['Olá! Quero um diagnóstico gratuito.', '', 'Nome: ' + payload.nome, 'Telefone: ' + payload.telefone];
          if (payload.empresa) lines.push('Empresa: ' + payload.empresa);
          lines.push('Serviço: ' + payload.servico);
          if (payload.mensagem) lines.push('', payload.mensagem);
          window.open('https://wa.me/' + WA + '?text=' + encodeURIComponent(lines.join('\n')), '_blank');
          onSuccess();
        }

        var timeout = new Promise(function (_, reject) { setTimeout(function () { reject(new Error('timeout')); }, 8000); });

        Promise.race([
          fetch(WEBHOOK_URL, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) })
            .then(function (r) { if (!r.ok) throw new Error(r.status); }),
          timeout,
        ]).then(onSuccess).catch(function () {
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({ event: 'erro_formulario_fallback', event_location: 'lead-form', event_label: payload.servico });
          fallbackWA();
        });
      });
    })();
    </script>

    <script is:inline>
    (function () {
      'use strict';
      var WA = '5531972039180';

      var form = document.getElementById('lead-form');
      var successEl = document.getElementById('lead-success');
      var recoveryEl = document.getElementById('lead-recovery');
      var waBtn = document.getElementById('lead-recovery-wa');
      var closeBtn = document.getElementById('lead-recovery-close');
      if (!form || !successEl || !recoveryEl || !waBtn || !closeBtn) return;

      var STORAGE_KEY = 'smartops_lead_recovery_shown';
      var alreadyShown = false;
      try { alreadyShown = sessionStorage.getItem(STORAGE_KEY) === '1'; } catch (e) {}

      function hasPartialData() {
        return form.nome.value.trim().length > 1 || form.telefone.value.trim().length > 3;
      }

      function buildMessage() {
        var lines = ['Olá! Comecei a preencher o formulário do site mas não terminei.', ''];
        if (form.nome.value.trim()) lines.push('Nome: ' + form.nome.value.trim());
        if (form.telefone.value.trim()) lines.push('Telefone: ' + form.telefone.value.trim());
        if (form.empresa.value.trim()) lines.push('Empresa: ' + form.empresa.value.trim());
        if (form.servico.value) lines.push('Interesse: ' + form.servico.options[form.servico.selectedIndex].text);
        if (form.mensagem.value.trim()) lines.push('', form.mensagem.value.trim());
        lines.push('', 'Pode me ajudar a continuar?');
        return lines.join('\n');
      }

      function showRecovery() {
        if (alreadyShown || !successEl.hidden || !hasPartialData()) return;
        alreadyShown = true;
        try { sessionStorage.setItem(STORAGE_KEY, '1'); } catch (e) {}
        waBtn.href = 'https://wa.me/' + WA + '?text=' + encodeURIComponent(buildMessage());
        recoveryEl.hidden = false;
        requestAnimationFrame(function () { recoveryEl.classList.add('is-visible'); });
      }

      function hideRecovery() {
        recoveryEl.classList.remove('is-visible');
        setTimeout(function () { recoveryEl.hidden = true; }, 350);
      }

      closeBtn.addEventListener('click', hideRecovery);

      // Gatilho 1: a seção do formulário sai da tela (rolou pra longe) sem enviar.
      var formSection = document.getElementById('contato');
      if (formSection && 'IntersectionObserver' in window) {
        var observer = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (!entry.isIntersecting) setTimeout(showRecovery, 4000);
          });
        }, { threshold: 0 });
        observer.observe(formSection);
      }

      // Gatilho 2: usuário voltou de outro app/aba (trocou de tela e retornou).
      document.addEventListener('visibilitychange', function () {
        if (document.visibilityState === 'visible') setTimeout(showRecovery, 800);
      });
    })();
    </script>

