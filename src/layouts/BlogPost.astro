---
import type { CollectionEntry } from 'astro:content';
import GTMHead from '../components/GTMHead.astro';
import GTMBody from '../components/GTMBody.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import MetaPixel from '../components/MetaPixel.astro';
import EventTracking from '../components/EventTracking.astro';
import Nav from '../components/Nav.astro';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, heroImage, author, tags, canonical, category } = post.data;

const categoryThumb: Record<string, string> = {
  'lean-six-sigma': '/img/blog-lean.svg',
  'automacao': '/img/blog-automacao.svg',
  'melhoria-continua': '/img/blog-melhoria.svg',
  'manutencao': '/img/blog-manutencao.svg',
  'geral': '/img/blog-geral.svg',
};

const resolvedHeroImage = heroImage && !heroImage.includes('placeholder')
  ? heroImage
  : (categoryThumb[category ?? 'geral'] ?? '/img/blog-geral.svg');

const categoryLabel: Record<string, string> = {
  'lean-six-sigma': 'Lean Six Sigma',
  'automacao': 'Automação com IA',
  'melhoria-continua': 'Melhoria Contínua',
  'manutencao': 'Manutenção & TI',
  'geral': 'Geral',
};

const siteURL = Astro.site ?? new URL('http://localhost:4321');
const canonicalURL = canonical ?? new URL(Astro.url.pathname, siteURL).href;
const ogImage = resolvedHeroImage.startsWith('http')
  ? resolvedHeroImage
  : new URL(resolvedHeroImage, siteURL).href;

const datePublished = pubDate.toISOString();
const dateModified = (updatedDate ?? pubDate).toISOString();

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    // ── Article ───────────────────────────────────────────────────────────
    {
      '@type': 'Article',
      '@id': `${canonicalURL}#article`,
      headline: title,
      description,
      image: {
        '@type': 'ImageObject',
        url: ogImage,
        width: 1200,
        height: 630,
      },
      author: {
        '@type': 'Person',
        name: author,
      },
      publisher: { '@id': `${siteURL.href}#organization` },
      datePublished,
      dateModified,
      mainEntityOfPage: { '@id': `${canonicalURL}#webpage` },
      inLanguage: 'pt-BR',
      keywords: tags.join(', '),
      articleSection: 'Tecnologia',
      isPartOf: { '@id': `${canonicalURL}#webpage` },
    },
    // ── WebPage ───────────────────────────────────────────────────────────
    {
      '@type': 'WebPage',
      '@id': `${canonicalURL}#webpage`,
      url: canonicalURL,
      name: `${title} | SmartOps IA`,
      description,
      inLanguage: 'pt-BR',
      isPartOf: { '@id': `${siteURL.href}#website` },
      breadcrumb: { '@id': `${canonicalURL}#breadcrumb` },
      datePublished,
      dateModified,
    },
    // ── BreadcrumbList ────────────────────────────────────────────────────
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonicalURL}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: siteURL.href },
        { '@type': 'ListItem', position: 2, name: 'Blog', item: new URL('/blog/', siteURL).href },
        { '@type': 'ListItem', position: 3, name: title, item: canonicalURL },
      ],
    },
  ],
};

function formatDate(date: Date) {
  return date.toLocaleDateString('pt-BR', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Preconnect para domínios críticos de terceiros -->
    <link rel="preconnect" href="https://www.googletagmanager.com" />
    <link rel="preconnect" href="https://www.google-analytics.com" />
    <link rel="dns-prefetch" href="https://connect.facebook.net" />

    <GTMHead />
    <MetaPixel />

    <!-- SEO primário -->
    <title>{title} | SmartOps IA</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- OpenGraph -->
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="SmartOps IA" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="article:published_time" content={datePublished} />
    <meta property="article:modified_time" content={dateModified} />
    <meta property="article:author" content={author} />
    {tags.map(tag => <meta property="article:tag" content={tag} />)}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <!-- Schema.org JSON-LD -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />

    <GoogleAnalytics />
  </head>

  <body>
    <GTMBody />
    <Nav current="/blog" />

    <main>
      <article>
        <header class="article-header">
          <img
            class="hero-image"
            src={resolvedHeroImage}
            alt={title}
            width="800"
            height="420"
            loading="eager"
            decoding="async"
          />
          <div class="article-meta">
            <div class="article-top-meta">
              {category && category !== 'geral' && (
                <a href={`/blog?categoria=${category}`} class="cat-badge">{categoryLabel[category] ?? category}</a>
              )}
              {tags.length > 0 && (
                <div class="tags">
                  {tags.map(tag => <span class="tag">{tag}</span>)}
                </div>
              )}
            </div>
            <h1 class="article-title">{title}</h1>
            <p class="article-description">{description}</p>
            <div class="article-info">
              <span class="author">Por {author}</span>
              <time datetime={datePublished}>{formatDate(pubDate)}</time>
              {updatedDate && (
                <span class="updated">
                  Atualizado em <time datetime={dateModified}>{formatDate(updatedDate)}</time>
                </span>
              )}
            </div>
          </div>
        </header>

        <div class="prose">
          <slot />
        </div>
      </article>
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <p>&copy; {new Date().getFullYear()} SmartOps IA · Lean Six Sigma &amp; Automação · Belo Horizonte, MG</p>
        <nav class="footer-nav">
          <a href="/">Home</a> · <a href="/lean-six-sigma">Lean Six Sigma</a> · <a href="/automacao">Automação</a> · <a href="/blog">Blog</a> · <a href="/sobre">Sobre</a>
        </nav>
      </div>
    </footer>
    <EventTracking />
  </body>
</html>

<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --bg: #07070f;
    --bg2: #0f0f1a;
    --fg: #e2e8f0;
    --muted: #94a3b8;
    --accent: #a78bfa;
    --accent-h: #8b5cf6;
    --accent-bg: rgba(167,139,250,0.12);
    --border: rgba(255,255,255,0.07);
    --code-bg: #0f0f1a;
    --max-w: 768px;
    --font: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
    --mono: 'Fira Code', 'Cascadia Code', Consolas, monospace;
  }

  html { scroll-behavior: smooth; }

  body {
    font-family: var(--font);
    background: var(--bg);
    color: var(--fg);
    line-height: 1.75;
    font-size: 1rem;
  }

  /* ── MAIN ── */
  main {
    max-width: calc(var(--max-w) + 4rem);
    margin: 0 auto;
    padding: 3rem 2rem 4rem;
  }

  /* ── ARTICLE HEADER ── */
  .hero-image {
    width: 100%;
    height: auto;
    border-radius: 14px;
    margin-bottom: 2.5rem;
    aspect-ratio: 1200 / 630;
    object-fit: cover;
  }

  .article-top-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem; margin-bottom: 1.25rem; }

  .cat-badge {
    display: inline-block;
    background: rgba(167,139,250,0.15);
    border: 1px solid rgba(167,139,250,0.3);
    color: #c4b5fd;
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-decoration: none;
  }

  .cat-badge:hover { background: rgba(167,139,250,0.25); }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tag {
    background: rgba(255,255,255,0.06);
    color: var(--muted);
    font-size: 0.68rem;
    font-weight: 600;
    padding: 0.2rem 0.65rem;
    border-radius: 9999px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .article-title {
    font-size: clamp(1.75rem, 4.5vw, 2.75rem);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.03em;
    margin-bottom: 1rem;
    color: #fff;
  }

  .article-description {
    font-size: 1.1rem;
    color: rgba(255,255,255,0.55);
    line-height: 1.65;
    margin-bottom: 1.75rem;
  }

  .article-info {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    font-size: 0.875rem;
    color: rgba(255,255,255,0.35);
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .author { font-weight: 700; color: rgba(255,255,255,0.7); }
  .updated { font-style: italic; }

  .article-header { margin-bottom: 3.5rem; }

  /* ── PROSE ── */
  .prose { max-width: var(--max-w); }
  .prose :global(h2) { font-size: 1.6rem; font-weight: 700; margin: 2.75rem 0 1rem; letter-spacing: -0.02em; }
  .prose :global(h3) { font-size: 1.25rem; font-weight: 700; margin: 2rem 0 0.75rem; }
  .prose :global(h4) { font-size: 1.1rem; font-weight: 600; margin: 1.5rem 0 0.5rem; }
  .prose :global(p) { margin-bottom: 1.5rem; }
  .prose :global(ul), .prose :global(ol) { margin-bottom: 1.5rem; padding-left: 1.75rem; }
  .prose :global(li) { margin-bottom: 0.5rem; }
  .prose :global(a) { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
  .prose :global(a:hover) { color: var(--accent-h); }
  .prose :global(strong) { font-weight: 700; }

  .prose :global(blockquote) {
    border-left: 4px solid var(--accent);
    margin: 2rem 0;
    padding: 1rem 1.5rem;
    background: var(--accent-bg);
    border-radius: 0 10px 10px 0;
    font-style: italic;
    color: var(--muted);
  }

  .prose :global(code) {
    background: var(--code-bg);
    color: var(--accent);
    padding: 0.15em 0.4em;
    border-radius: 5px;
    font-family: var(--mono);
    font-size: 0.875em;
  }

  .prose :global(pre) {
    background: var(--code-bg);
    padding: 1.5rem;
    border-radius: 12px;
    overflow-x: auto;
    margin-bottom: 1.75rem;
    font-family: var(--mono);
    font-size: 0.875rem;
    line-height: 1.65;
    border: 1px solid var(--border);
  }

  .prose :global(pre code) { background: transparent; color: inherit; padding: 0; font-size: inherit; }

  .prose :global(img) { width: 100%; height: auto; border-radius: 10px; margin: 1.75rem 0; }
  .prose :global(hr) { border: none; border-top: 1px solid var(--border); margin: 3rem 0; }

  .prose :global(table) { width: 100%; border-collapse: collapse; margin-bottom: 1.75rem; font-size: 0.875rem; }
  .prose :global(th), .prose :global(td) { padding: 0.75rem 1rem; border: 1px solid var(--border); text-align: left; }
  .prose :global(th) { background: var(--bg2); font-weight: 700; }

  /* ── PROSE COLORS ── */
  .prose :global(h2), .prose :global(h3), .prose :global(h4) { color: #fff; }
  .prose :global(p) { color: var(--fg); }
  .prose :global(blockquote) {
    border-left: 4px solid var(--accent);
    margin: 2rem 0;
    padding: 1rem 1.5rem;
    background: var(--accent-bg);
    border-radius: 0 10px 10px 0;
    font-style: italic;
    color: var(--muted);
  }

  /* ── FOOTER ── */
  .site-footer {
    background: #04040a;
    border-top: 1px solid rgba(255,255,255,0.05);
    padding: 2rem 0;
    text-align: center;
    margin-top: 5rem;
  }
  .footer-inner { max-width: calc(var(--max-w) + 4rem); margin: 0 auto; padding: 0 2rem; }
  .site-footer p { font-size: 0.8rem; color: rgba(255,255,255,0.3); margin-bottom: 0.5rem; }
  .footer-nav a { font-size: 0.8rem; color: rgba(255,255,255,0.3); text-decoration: none; }
  .footer-nav a:hover { color: #fff; }

  /* ── RESPONSIVE ── */
  @media (max-width: 640px) {
    main { padding: 2rem 1rem 3rem; }
  }
</style>
