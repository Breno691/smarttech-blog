---
interface Props {
  current?: string;
}
const { current = '' } = Astro.props;

const whatsappURL = 'https://wa.me/5531972039180?text=' + encodeURIComponent('Olá! Vim pelo site da SmartOps e quero saber mais.');

const links = [
  { href: '/', label: 'Home' },
  { href: '/lean-six-sigma', label: 'Lean Six Sigma' },
  { href: '/automacao', label: 'Automação com IA' },
  { href: '/blog', label: 'Blog' },
  { href: '/sobre', label: 'Sobre' },
];
---

<header class="site-header">
  <nav class="site-nav">
    <a href="/" class="nav-logo" aria-label="SmartOps IA — página inicial">
      Smart<span>Ops</span> <em>IA</em>
    </a>

    <div class="nav-links" id="nav-links">
      {links.map(l => (
        <a href={l.href} class={current === l.href ? 'active' : ''}>{l.label}</a>
      ))}
    </div>

    <a href={whatsappURL} class="nav-cta" target="_blank" rel="noopener noreferrer">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
        <path d="M12 0C5.373 0 0 5.373 0 12c0 2.127.558 4.122 1.532 5.856L0 24l6.335-1.611A11.945 11.945 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.818 9.818 0 0 1-5.003-1.372l-.359-.214-3.723.947.985-3.596-.235-.369A9.818 9.818 0 1 1 12 21.818z"/>
      </svg>
      Falar agora
    </a>

    <button class="nav-burger" id="nav-burger" aria-label="Abrir menu" aria-expanded="false" aria-controls="nav-links">
      <span></span><span></span><span></span>
    </button>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(10, 10, 20, 0.92);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(255,255,255,0.06);
  }

  .site-nav {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
    height: 64px;
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .nav-logo {
    font-size: 1.2rem;
    font-weight: 800;
    color: #fff;
    text-decoration: none;
    letter-spacing: -0.02em;
    flex-shrink: 0;
  }
  .nav-logo span { color: #a78bfa; }
  .nav-logo em { font-style: normal; color: #10b981; font-size: 0.85em; }

  .nav-links {
    display: flex;
    gap: 0.25rem;
    margin-left: auto;
  }

  .nav-links a {
    color: rgba(255,255,255,0.65);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    padding: 0.4rem 0.75rem;
    border-radius: 6px;
    transition: color 0.2s, background 0.2s;
    white-space: nowrap;
  }
  .nav-links a:hover,
  .nav-links a.active {
    color: #fff;
    background: rgba(255,255,255,0.07);
  }

  .nav-cta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    background: #25d366;
    color: #fff;
    font-size: 0.85rem;
    font-weight: 600;
    padding: 0.45rem 1rem;
    border-radius: 8px;
    text-decoration: none;
    flex-shrink: 0;
    transition: background 0.2s;
  }
  .nav-cta:hover { background: #1db954; }

  .nav-burger {
    display: none;
    flex-direction: column;
    gap: 4px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    margin-left: auto;
  }
  .nav-burger span {
    display: block;
    width: 22px;
    height: 2px;
    background: #fff;
    border-radius: 2px;
    transition: all 0.25s;
  }

  @media (max-width: 768px) {
    .nav-burger { display: flex; }
    .nav-links {
      display: none;
      position: absolute;
      top: 64px;
      left: 0;
      right: 0;
      flex-direction: column;
      background: #0a0a14;
      border-bottom: 1px solid rgba(255,255,255,0.08);
      padding: 1rem 1.5rem;
      gap: 0.25rem;
    }
    .nav-links.open { display: flex; }
    .nav-links a { font-size: 1rem; padding: 0.6rem 0.75rem; }
    .nav-cta { display: none; }
  }
</style>

<script>
  const burger = document.getElementById('nav-burger');
  const links = document.getElementById('nav-links');
  burger?.addEventListener('click', () => {
    const open = links?.classList.toggle('open');
    burger.setAttribute('aria-expanded', String(open));
  });
</script>
